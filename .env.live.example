# Live MTN-sandbox credentials for the `live` profile test. Copy to `.env.live`
# (git-ignored) and fill in your own real MTN sandbox values — never commit the
# filled file. This is the template for it; the names must match the ${VAR}
# placeholders in config/application-live.yml, which the server resolves from
# the process environment and refuses to boot without (unresolved placeholder
# = exit 78, never an empty string).
#
# Source it in every terminal that runs the stack:
#   set -a; . ./.env.live; set +a
#
# See docs/runbooks/live-sandbox-test.md for the full walkthrough.

# Your MTN MoMo COLLECTIONS subscription key (the Collections product, not
# Disbursements). Referenced by config/application-live.yml as ${MTN_SUBSCRIPTION_KEY}.
MTN_SUBSCRIPTION_KEY=

# The api_user UUID you created via POST /v1_0/apiuser. An identifier, not a
# secret. Referenced as ${MTN_API_USER}.
MTN_API_USER=

# The API key created via POST /v1_0/apiuser/{uuid}/apikey. Referenced as ${MTN_API_KEY}.
MTN_API_KEY=

# No MTN_DISBURSEMENT_* here, and that is deliberate. `mtn_momo::refund` is
# implemented as of 2026-09-15 and needs three more names
# (MTN_DISBURSEMENT_SUBSCRIPTION_KEY / _API_KEY / _API_USER), but
# config/application-live.yml does not reference them: this runbook is a
# COLLECTIONS sandbox test, nobody has been issued a Disbursements
# subscription, and an unreferenced variable is one less thing to get wrong.
# The refund call has never been made against MTN — see docs/status.md.

# --- live-merchant's PUBLIC JWK halves (ADR-0010) ---
# The `kid` and the RSA modulus `n` printed by
#   cargo xtask gen-signing-key --out .e2e/live-merchant
# config/application-live.yml references them as ${LIVE_MERCHANT_JWK_KID} and
# ${LIVE_MERCHANT_JWK_N}. These are the PUBLIC half (safe to keep local); the
# private half stays in .e2e/live-merchant/oauth-signing-key.pem (git-ignored).
LIVE_MERCHANT_JWK_KID=
LIVE_MERCHANT_JWK_N=

# --- live-merchant's Ed25519 PUBLIC key, which authenticates every /v1 request ---
# The `public key:` line printed by
#   cargo xtask gen-envelope-key --out .e2e/live-merchant --name signing
# (also in .e2e/live-merchant/signing.pub). Referenced as ${LIVE_MERCHANT_COSE_KEY}.
# The private half is .e2e/live-merchant/signing.seed (git-ignored).
LIVE_MERCHANT_COSE_KEY=

# Optional overrides. The defaults are shown; set them only to diverge.
# VPAY_BASE_URL=http://localhost:8080            # where the API is reachable
# CHECKOUT_BROWSER_PORT=4180                     # the payer page's port
