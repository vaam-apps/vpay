    "lint": "pnpm run deps && eslint . --max-warnings 0",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vaam-apps/vpay-tauri-checkout": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@vpay/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  }
}
