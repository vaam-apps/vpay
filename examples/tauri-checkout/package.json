{
  "name": "@vpay/example-tauri-checkout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps": "pnpm --filter @vaam-apps/vpay-tauri-checkout build",
    "dev": "vite",
    "build": "pnpm run deps && tsc --noEmit -p tsconfig.json && vite build",
