// The shop's data model, in ZenStack's schema language.
//
// `zenstack generate` compiles this into `prisma/schema.prisma` (committed,
// because `prisma migrate deploy` in the container's entrypoint reads it) and
// into the `@zenstackhq/runtime` metadata that `enhance()` consults. The
// zmodel is the source of truth; never edit `prisma/schema.prisma` by hand.
//
// # About the access policies below
//
// D13 of docs/plans/2026-09-04-step9-hosted-checkout.md: guest checkout, no
// accounts, no admin. There is therefore no authenticated principal, and a
// policy of the form `@@allow('all', auth() != null)` would be a claim of
// protection this shop cannot make.
//
// So the policies here are the ones that are *true of every caller*, which is
// the only kind this shop can enforce honestly:
//
//   - The catalogue is read-only to the application. It is seeded by a
//     migration and no code path may change it (D13's "products are seed
//     data"). `enhance()` refuses `product.create/update/delete` — proven in
//     `src/server/store/policies.test.ts`, which deletes nothing and instead
//     asserts the refusal, and which fails if the `@@allow` line below is
//     widened.
//   - `WebhookEvent` is append-only: a delivery record may be written and
//     read, never rewritten or removed. The dedupe guarantee depends on that.
//   - Orders and their items are never deleted. A cancelled order is a row
//     with `status = cancelled`, not an absence.
//
// What these do NOT do is stop one payer reading another payer's order: there
// is no principal to compare against, and `orders.get` is reachable by anyone
// holding an order id. That is stated in the README rather than papered over
// with a rule that would evaluate to `true`.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// What the shop knows about an order's money.
///
/// `unpaid` is the initial state and the only one a payer's browser can
/// cause. `paid`, `failed` and `cancelled` are written **only** by the
/// webhook handler, from a signature-verified event — never from a return
/// URL (D11: "the order page shows `paid` only from the webhook").
enum OrderStatus {
  unpaid
  paid
  failed
  cancelled
}

/// A catalogue item. Seeded by `prisma/migrations/*_seed_catalogue`, never
/// written by the application.
model Product {
  id String @id

  name        String
  description String

  /// **Integer minor units**, per docs/flows/money.md. XAF is zero-decimal,
  /// so `250000` is 250,000 FCFA — not 2,500.00. There is no floating point
  /// anywhere in this shop's money path for the same reason there is none in
  /// vpay's.
  priceMinor Int @map("price_minor")

  /// Lowercase ISO 4217, as `/v1` takes it. Every row is `xaf`; an order
  /// mixing currencies is refused server-side rather than silently summed.
  currency String

  items OrderItem[]

  @@allow('read', true)
  @@map("products")
}

/// A guest order. The e-mail is the only thing the shop knows about the payer
/// (D13), and it is collected for a receipt a real shop would send — this one
/// sends nothing.
model Order {
  id String @id @default(cuid())

  /// **Optional**, and that is a decision rather than a slack constraint:
  /// the shop asks for an e-mail so it can send a receipt, and a receipt is
  /// not a condition of paying. The identity on a mobile-money payment is
  /// the payer's phone number, which the rail holds and the shop never sees
  /// (the customers decision of 2026-09-05: phone-only customers are
  /// allowed). A shop that made the e-mail mandatory would be collecting a
  /// second identifier it has no use for.
  email String?

  status OrderStatus @default(unpaid)

  /// The server-computed sum of `priceMinor * quantity` over `items`, in the
  /// same minor units. Never read from the browser's cart.
  totalMinor Int @map("total_minor")

  currency String

  /// The `pi_…` this order is being paid with. Unique: one intent belongs to
  /// at most one order, which is what makes the webhook's lookup by intent id
  /// unambiguous. Null until `orders.create` has reached vpay.
  paymentIntentId String? @unique @map("payment_intent_id")

  /// The `cs_…` vpay minted for this order, hosted or embedded. Stored so the
  /// order page can name it and so a repeated `orders.embeddedSecret` call
  /// retrieves the session it already created instead of minting a second one.
  checkoutSessionId String? @map("checkout_session_id")

  /// vpay's `last_payment_error.code` — one of the eleven in
  /// `vpay_core::failure::FailureCode` — written by the webhook handler and
  /// by nothing else, and only when an order becomes `failed`. Stored
  /// because the delivered event is the only place it ever appears: this
  /// shop never calls vpay to read an intent.
  failureCode String? @map("failure_code")

  /// The message that came with it. The rail's own words, kept for an
  /// operator; a buyer reads the shop's copy for the code instead
  /// (`src/lib/failures.ts`).
  failureMessage String? @map("failure_message")

  items         OrderItem[]
  webhookEvents WebhookEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([paymentIntentId])
  @@allow('create,read,update', true)
  @@map("orders")
}

/// One line of an order, with the price **copied at order time**. A later
/// catalogue change must not silently restate what a payer agreed to.
model OrderItem {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @map("order_id")

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  quantity  Int
  unitMinor Int @map("unit_minor")

  @@index([orderId])
  @@allow('create,read', true)
  @@map("order_items")
}

/// One vpay event this shop has already acted on, keyed by **vpay's own event
/// id**. Webhook delivery is at-least-once (docs/flows/webhooks.md), so this
/// table is what makes a replay a no-op rather than a second state change.
model WebhookEvent {
  /// vpay's `evt_…`. The primary key *is* the dedupe.
  id String @id

  type String

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String? @map("order_id")

  receivedAt DateTime @default(now()) @map("received_at")

  @@index([orderId])
  @@allow('create,read', true)
  @@map("webhook_events")
}
