datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// What the shop knows about an order's money.
///
/// `unpaid` is the initial state and the only one a payer's browser can
/// cause. `paid`, `failed` and `cancelled` are written **only** by the
/// webhook handler, from a signature-verified event — never from a return
/// URL (D11: "the order page shows `paid` only from the webhook").
enum OrderStatus {
  unpaid
  paid
  failed
  cancelled
}

/// A catalogue item. Seeded by `prisma/migrations/*_seed_catalogue`, never
/// written by the application.
model Product {
  id          String      @id()
  name        String
  description String
  /// **Integer minor units**, per docs/flows/money.md. XAF is zero-decimal,
  /// so `250000` is 250,000 FCFA — not 2,500.00. There is no floating point
  /// anywhere in this shop's money path for the same reason there is none in
  /// vpay's.
  priceMinor  Int         @map("price_minor")
  /// Lowercase ISO 4217, as `/v1` takes it. Every row is `xaf`; an order
  /// mixing currencies is refused server-side rather than silently summed.
  currency    String
  items       OrderItem[]

  @@map("products")
}

/// A guest order. The e-mail is the only thing the shop knows about the payer
/// (D13), and it is collected for a receipt a real shop would send — this one
/// sends nothing.
model Order {
  id                String         @id() @default(cuid())
  email             String
  status            OrderStatus    @default(unpaid)
  /// The server-computed sum of `priceMinor * quantity` over `items`, in the
  /// same minor units. Never read from the browser's cart.
  totalMinor        Int            @map("total_minor")
  currency          String
  /// The `pi_…` this order is being paid with. Unique: one intent belongs to
  /// at most one order, which is what makes the webhook's lookup by intent id
  /// unambiguous. Null until `orders.create` has reached vpay.
  paymentIntentId   String?        @unique() @map("payment_intent_id")
  /// The `cs_…` vpay minted for this order, hosted or embedded. Stored so the
  /// order page can name it and so a repeated `orders.embeddedSecret` call
  /// retrieves the session it already created instead of minting a second one.
  checkoutSessionId String?        @map("checkout_session_id")
  items             OrderItem[]
  webhookEvents     WebhookEvent[]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt() @map("updated_at")

  @@index([paymentIntentId])
  @@map("orders")
}

/// One line of an order, with the price **copied at order time**. A later
/// catalogue change must not silently restate what a payer agreed to.
model OrderItem {
  id        String  @id() @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String  @map("order_id")
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")
  quantity  Int
  unitMinor Int     @map("unit_minor")

  @@index([orderId])
  @@map("order_items")
}

/// One vpay event this shop has already acted on, keyed by **vpay's own event
/// id**. Webhook delivery is at-least-once (docs/flows/webhooks.md), so this
/// table is what makes a replay a no-op rather than a second state change.
model WebhookEvent {
  /// vpay's `evt_…`. The primary key *is* the dedupe.
  id         String   @id()
  type       String
  order      Order?   @relation(fields: [orderId], references: [id])
  orderId    String?  @map("order_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([orderId])
  @@map("webhook_events")
}
