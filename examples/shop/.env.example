# examples/shop — every variable the shop reads. Copy to `.env` (git-ignored)
# for local development; in the demo stack these are set on the `vpay-shop`
# compose service instead (`compose.e2e.yml`, republished by
# `compose.demo.yml`). See docs/plans/step9-notes/lane-7.md for the compose
# block and the merchant registration these correspond to.
#
# Two kinds of value live here, and mixing them up is how this file went
# stale once already (r2 review, finding 10):
#
#   * Values that MUST match the demo stack, because something on the other
#     side of a signature or a CSP header is holding the same string:
#     `VPAY_CLIENT_ID`, `VPAY_PUBLISHABLE_KEY`, `VPAY_WEBHOOK_SECRET` and
#     `VPAY_CHECKOUT_URL`. Each says so on its own line below.
#   * Values that are LOCAL-DEV defaults and deliberately differ from the
#     compose stack's, because outside compose the shop is `next dev` on
#     3000 and Postgres is wherever you put it: `DATABASE_URL` and
#     `SHOP_PUBLIC_URL`. The demo stack's are `postgres://…@postgres:5432/shop`
#     and `http://localhost:3001`; note that `compose.demo.yml` does not
#     publish Postgres at all, so 5432 is not reachable while `just demo` is
#     up.

# ---------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------
# A LOCAL-DEV value: whatever Postgres you point `next dev` at. In the demo
# stack this is `postgres://vpay:vpay@postgres:5432/shop` over the compose
# network — its own database in the shared `postgres` container, created by
# an init script (lane 4) — and `zen migrate deploy` runs against it at
# container start and seeds the catalogue.
#
# Read by `pg` directly (`src/server/db.ts`), not by a datasource block: since
# the ZenStack 3 upgrade of 2026-09-06 there is no Prisma client in the
# request path. `zen migrate` still reads it, through the Prisma schema it
# derives from the zmodel. `compose.demo.yml` publishes no
# host port for Postgres, so the URL below reaches nothing while `just demo`
# is up.
DATABASE_URL=postgresql://vpay:vpay@localhost:5432/shop?schema=public

# ---------------------------------------------------------------------------
# vpay, server side
# ---------------------------------------------------------------------------
# The API as THIS SERVER reaches it. Inside compose that is the service name.
VPAY_API_URL=http://localhost:8080

# The `aud` this shop signs its client assertion with: vpay's OP as VPAY
# names itself, `{deployment.public_base_url}/v1/oauth/token`. Optional;
# unset means "the same URL we POST to", which is right only when this server
# reaches vpay the way payers do.
#
# The worked example is the demo stack, where they differ. This container
# reaches vpay at `http://vpay-server:8080` (above), but vpay's
# `deployment.public_base_url` is the published host port, so its OP calls
# itself `http://localhost:8080/v1/oauth/token`. `authenticate_client`
# compares the `aud` claim against that name and the `/v1/oauth` issuer, and
# against nothing else — the URL you POSTed to is never consulted. Leave this
# unset there and every token request answers `invalid_client`, with the
# signature, the client_id, the kid and the lifetime all correct and nothing
# in the response pointing at the audience. `compose.e2e.yml` sets it.
# VPAY_OAUTH_AUDIENCE=http://localhost:8080/v1/oauth/token

# The merchant this shop is (D12: its own registration, not `demo-merchant`).
# Must match a `merchant_clients[].client_id` vpay holds a public JWK for —
# `just gen-demo-keys` writes exactly this one.
VPAY_CLIENT_ID=shop-merchant

# The PEM holding the merchant's RSA private key. A path, never the key
# itself: a key in an environment variable ends up in `docker inspect`, in a
# process listing and in any crash report that dumps the environment. The
# demo's copy is written by `just gen-demo-keys` and is mounted read-only.
VPAY_PRIVATE_KEY_FILE=../../.e2e/shop-merchant/oauth-signing-key.pem

# The signing secret of this shop's webhook endpoint in vpay's merchant
# config. `verifyWebhook` from @vaam-apps/vpay-sdk checks the `Vpay-Signature` header
# against it; nothing else in the shop reads it.
#
# **It must be byte-identical to the `shop-merchant` endpoint's secret in
# `.e2e/application-demo.yml`** — the `webhooks[0].secrets` entry `just
# gen-demo-keys` writes as `${SHOP_WEBHOOK_SECRET}`, which vpay-server
# resolves from its own environment. Both sides read the same
# `${SHOP_WEBHOOK_SECRET:-whsec-shop-demo-secret-32-bytes-xx}` default in
# `compose.e2e.yml` (once for `vpay-server`, once for `vpay-shop`), which is
# the value below. If the two ever differ, every delivery this shop verifies
# is a 400 and no order ever reaches `paid`.
VPAY_WEBHOOK_SECRET=whsec-shop-demo-secret-32-bytes-xx

# ---------------------------------------------------------------------------
# vpay, browser side
# ---------------------------------------------------------------------------
# Public by name. It is rendered into the embedded page, names the tenant, and
# authorises nothing on its own. Must match `shop-merchant`'s
# `publishable_keys` entry in the generated overlay, or every browser call is
# the surface's uniform 404.
VPAY_PUBLISHABLE_KEY=pk_test_shopmerchantsandbox1

# The checkout app's origin — the deployment's `checkout.public_base_url`.
# This one is read by a BROWSER (it is the iframe's `src`), so in compose it
# must be the host-published URL, not a service name. The demo stack
# publishes `vpay-checkout` on 3080 (`demo_checkout_port`), and the generated
# overlay's `checkout.public_base_url` is the same `http://localhost:3080`.
VPAY_CHECKOUT_URL=http://localhost:3080

# The API as a BROWSER reaches it. Defaults to VPAY_API_URL, which is right
# only when the two are the same host — inside compose they are not.
VPAY_BROWSER_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# The shop
# ---------------------------------------------------------------------------
# Where a payer's browser reaches this shop. vpay redirects here, so it must be
# the externally reachable origin, not the compose service name. A LOCAL-DEV
# value: 3000 is `next dev`'s port. The demo stack publishes the shop on 3001
# (`demo_shop_port`, because the dashboard has 3000 in the file set) and sets
# `SHOP_PUBLIC_URL=http://localhost:3001` to match.
SHOP_PUBLIC_URL=http://localhost:3000

# Which rails to put on the PaymentIntent. Optional; defaults to both, and
# the demo stack deliberately leaves it unset.
#
# Two shapes, since 2026-09-06. A plain list applies to every currency:
#
#   SHOP_PAYMENT_METHOD_TYPES=mtn_momo,orange_money
#
# A per-currency map applies a different list per currency, `;` between
# groups and `,` inside one:
#
#   SHOP_PAYMENT_METHOD_TYPES=xaf:orange_money;eur:mtn_momo
#
# The rails are resolved against the ORDER's currency when the intent is
# created, and a currency with no rails is a refusal naming it, raised before
# the order row is written.
#
# Worth reading before you change it: the catalogue is priced in XAF, and
# vpay refuses a confirm whose rail settles in another currency than the
# intent. Against the DEMO overlay both rails settle XAF — `just
# gen-demo-keys` writes a `providers:` block that puts `mtn_momo` on
# `currency: XAF`, and then checks that it did, which is what makes the
# shop's MTN button payable — so both complete and the default is right.
#
# Against `config/application.yml` unmodified, `mtn_momo` settles EUR
# (**MTN's real sandbox rejects XAF**; docs/flows/money.md) and an XAF order
# can only be paid on Orange. Point the shop at such a deployment and set
# this to `orange_money`, or to `xaf:orange_money`, to offer only the rail
# that can complete. Configuration either way — never a code branch
# (ADR-0003).
# SHOP_PAYMENT_METHOD_TYPES=mtn_momo,orange_money

# Which surface the checkout page opens on: `hosted` (a full-page redirect to
# vpay), `popup` (vpay's hosted page in a window this shop opens) or
# `embedded` (vpay's page in an iframe). Optional; defaults to `hosted`.
#
# THE INTEGRATION MODE IS THE DEVELOPER'S CONFIGURATION. A real merchant sets
# this once and never shows a switch. This example's checkout page does show
# one — starting on whatever is set here — because an example that could only
# demonstrate the mode its environment file happened to name would be
# demonstrating a third of itself. That switch is a demo affordance and says
# so on the page.
# SHOP_CHECKOUT_MODE=hosted
