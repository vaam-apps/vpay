{
  "mappings": [
    {
      "name": "requestToPay accepted (202, empty body — the id is the caller's)",
      "request": { "method": "POST", "urlPath": "/collection/v1_0/requesttopay" },
      "response": { "status": 202 }
    },
    {
      "name": "duplicate reference is reported as already existing",
      "request": {
        "method": "POST",
        "urlPath": "/collection/v1_0/requesttopay",
        "headers": { "X-Reference-Id": { "equalTo": "00000000-0000-0000-0000-0000000000dd" } }
      },
      "response": {
        "status": 409,
        "jsonBody": { "code": "RESOURCE_ALREADY_EXIST", "message": "Duplicated Reference Id" }
      }
    },
    {
      "name": "status: successful",
      "request": { "method": "GET", "urlPathPattern": "/collection/v1_0/requesttopay/.*" },
      "response": {
        "status": 200,
        "jsonBody": {
          "financialTransactionId": "1234567890",
          "amount": "5000",
          "currency": "XAF",
          "status": "SUCCESSFUL"
        }
      }
    }
  ]
}
