    {
      "name": "read: slower than the configured deadline",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/payments/trx.test_00000000-0000-0000-0000-000000000560",
        "headers": {
          "X-Grant": {
            "matches": ".+"
          },
          "Authorization": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 202,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"code\":202,\"status\":\"Accepted\",\"message\":\"Payment retrieved\",\"transaction\":{\"reference\":\"trx.test_00000000-0000-0000-0000-000000000560\",\"trxref\":\"00000000-0000-0000-0000-000000000560\",\"amount\":5000,\"amounts\":{\"converted\":5000,\"currency\":\"XAF\",\"rate\":1,\"total\":5000},\"currency\":\"XAF\",\"status\":\"pending\"}}",
        "fixedDelayMilliseconds": 2000
      },
      "metadata": {
        "why": "REF_SLOW. Two orders of magnitude above the suite's SHORT_REQUEST_TIMEOUT, so the case proves the adapter applies ProviderConfig::request_timeout per request (Client::with_request_timeout)."
      }
    },
    {
      "name": "read: a body far larger than any answer Notch Pay documents",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/payments/trx.test_00000000-0000-0000-0000-000000000b16",
        "headers": {
          "X-Grant": {
            "matches": ".+"
          },
          "Authorization": {
            "matches": ".+"
          }
        }
      },
      "response": {
        "status": 202,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"code\":202,\"transaction\":{\"reference\":\"trx.test_00000000-0000-0000-0000-000000000b16\",\"trxref\":\"00000000-0000-0000-0000-000000000b16\",\"amount\":5000,\"amounts\":{\"converted\":5000,\"currency\":\"XAF\",\"rate\":1,\"total\":5000},\"currency\":\"XAF\",\"status\":\"complete\"},\"padding\":\"{{randomValue length=300000 type='ALPHANUMERIC'}}\"}"
      },
      "metadata": {
        "why": "REF_HUGE. A valid complete read padded past MAX_RAIL_BODY_BYTES (256 KiB), so without the bound the adapter would answer Succeeded."
      }
    },
