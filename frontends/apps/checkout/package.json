{
  "name": "@vpay/checkout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps": "pnpm --filter @vaam-apps/vpay-stripe-js build",
    "dev": "pnpm run deps && next dev -p 3001",
    "build": "pnpm run deps && next build",
    "start": "next start -p 3001",
    "typecheck": "pnpm run deps && tsc --noEmit",
    "test": "pnpm run deps && vitest run",
    "lint": "pnpm run deps && eslint . --max-warnings 0"
  },
  "dependencies": {
    "@vaam-apps/ui": "^0.1.1",
    "@vaam-apps/vpay-stripe-js": "workspace:*",
    "@vpay/tokens": "workspace:*",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@storybook/react": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vpay/config": "workspace:*",
    "daisyui": "5.7.28",
    "eslint": "9.39.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
