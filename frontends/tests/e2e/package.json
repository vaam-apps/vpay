{
  "name": "@vpay/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "pnpm run e2e:default && pnpm run e2e:framed",
    "e2e:default": "cypress run",
    "e2e:framed": "VPAY_E2E_FRAMED=1 cypress run",
    "open": "cypress open",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run deps && eslint . --max-warnings 0",
    "deps": "pnpm --filter @vaam-apps/vpay-sdk build"
  },
  "devDependencies": {
    "@vpay/config": "workspace:*",
    "@vaam-apps/vpay-sdk": "workspace:*",
    "cypress": "^15.21.1",
    "eslint": "9.39.5",
    "typescript": "^5.7.0"
  }
}
