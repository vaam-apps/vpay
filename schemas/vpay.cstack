// vpay — CrateStack schema
//
// ┌──────────────────────────────────────────────────────────────────────────┐
// │ STATUS: PARTLY COMPILED SINCE 2026-09-06 — ONE MODEL IS REAL, THE        │
// │ REST IS A DESIGN SKETCH                                                  │
// │                                                                          │
// │ This file used to say "NOT WIRED IN" and "EXCLUDED FROM THE BUILD        │
// │ GRAPH". Both stopped being true on 2026-09-06:                           │
// │ backends/crates/vpay-db/src/schema.rs now invokes                        │
// │ include_server_schema!("../../../schemas/vpay.cstack", db = Postgres),   │
// │ so EVERY declaration below is compiled by rustc into `vpay-db` on        │
// │ every build, and a syntax or type error here is a build failure          │
// │ rather than a gate failure. The generated module is PRIVATE to           │
// │ `vpay-db` and re-exported nowhere (ADR-0016 standard 5; `cargo xtask     │
// │ verify-repositories` fails if that changes).                             │
// │                                                                          │
// │ Compiled is not the same as used, and the difference matters more        │
// │ than usual here. Exactly ONE model — `DisabledClient` — has queries      │
// │ running through it, and since 2026-09-06 it has all three of them:       │
// │ `is_client_disabled` is `find_unique(...).run(ctx)`, `disable_client`    │
// │ is `upsert(...).run(ctx)` and `enable_client` is                         │
// │ `delete_many().where_(...).run(ctx)`. This box said "the two             │
// │ `disabled_clients` WRITES are still raw sqlx" until then; no raw sqlx    │
// │ statement against that table is left in `vpay-db`. Every other model     │
// │ below is still a design sketch that happens to be type-checked by a      │
// │ compiler as well as by the CLI; no code reads or writes through any of   │
// │ them, and several do not match the live table at all (see the drift      │
// │ list). docs/status.md is the authoritative done/not-done list.           │
// │                                                                          │
// │ The content was rewritten against the real grammar in 2026-09, field     │
// │ by field against cratestack-parser's own test suite rather than          │
// │ guessed from an overview page. (An earlier note blamed                   │
// │ "cratestack.dev/docs 404s publicly". Corrected 2026-09-05: /docs does    │
// │ 404, but the docs are at cratestack.dev/getting-started/quickstart,      │
// │ /guides/*, /architecture/*, /reference/* and /tooling/*.)                │
// │                                                                          │
// │ TWO INDEPENDENT THINGS CHECK THIS FILE, and they are not the same        │
// │ check. `just check-schema` runs                                          │
// │   $ cratestack check --schema schemas/vpay.cstack                        │
// │   schema OK: schemas/vpay.cstack                                         │
// │ as the seventh gate in `just verify`, at the CLI version pinned as       │
// │ `cratestack_version` in the justfile — 0.11.1 today, the same version    │
// │ `Cargo.toml` pins the LIBRARY to, which is why the two cannot answer     │
// │ about different grammars. `cargo build` is the other: the macro          │
// │ parses this file with `cratestack-parser` and fails the build on         │
// │ anything the CLI would reject, and on some things it would not           │
// │ (composite `@@id`, list-arity scalars on a database-backed model).       │
// │                                                                          │
// │ The 0.10 grammar added block attributes this file does not use (@@sql,   │
// │ @@embedded_sql, @@server_sql for views; @@paged, @@subscribe, @@audit,   │
// │ @@soft_delete). 0.11.1 still has no @@check(expr) — no hit for           │
// │ '@@check' anywhere in cratestack-parser 0.11.1 or cratestack-migrate     │
// │ 0.11.1, and the latter's convert/checks.rs still promotes a CHECK only   │
// │ from @db_enforce on a single field — so the GAP notes on cross-column    │
// │ CHECKs below remain accurate. (KNOWN_ATTRIBUTE_NAMES was cited here      │
// │ too until 2026-09-05; it is a typo-suggestion table and lists no         │
// │ 'index' either, so it proves nothing. See docs/status.md.)               │
// │                                                                          │
// │ THE GAP TO THE MIGRATIONS IS MEASURED, AND IT MUST MOVE WHEN THIS        │
// │ FILE GROWS. `cratestack migrate baseline --strict` runs against a        │
// │ real, fully migrated vpay Postgres in postgres_smoke.rs::the_cstack_     │
// │ schema_drifts_from_the_migrations_by_a_measured_amount, which pins the   │
// │ count, the number of relations it is spread over, and the exact set of   │
// │ tables the database has and this file does not. 86 changes over 17       │
// │ relations on 2026-09-05; **85 over 16 since 2026-09-06**, when           │
// │ `DisabledClient` landed and `disabled_clients` left the report           │
// │ entirely. That is a comparison, not a migration source: nothing          │
// │ generates DDL from this file and it drives no migration —                │
// │ `backends/migrations/*.sql` remains the authoritative schema.            │
// │                                                                          │
// │ What the measurement added to the GAP notes below: the two               │
// │ cross-column CHECKs are not just inexpressible here, they are            │
// │ INVISIBLE to `migrate baseline` — all ten multi-column CHECKs in the     │
// │ database are — so a clean --strict run would say nothing about either    │
// │ of them. That is CrateStack's own documented gap: cratestack-migrate     │
// │ 0.11.1's src/introspect/postgres/mod.rs lists "Multi-column and          │
// │ zero-column CHECK constraints are skipped" because AddCheck ties to      │
// │ exactly one column. So the ask below is not only @@check(expr) in the    │
// │ grammar — it needs an IR op that is not single-column and                │
// │ introspection that reads array_length(conkey, 1) > 1, or a parsed        │
// │ @@check would still be invisible to migrate baseline and migrate diff.   │
// │ See docs/status.md, "The measured drift", and                            │
// │ docs/plans/exp13-notes/opus.md.                                          │
// │                                                                          │
// │ One more thing the rewrite had to learn the hard way: `cratestack        │
// │ check` rejects column-aligned field declarations (multiple spaces        │
// │ between a field name and its type) with a confusing "invalid type        │
// │ reference" error that points at the wrong token entirely. Every field    │
// │ below is therefore single-spaced, matching the real project's own        │
// │ example schemas — not a style choice, a parser constraint.               │
// │                                                                          │
// │ Apart from `DisabledClient`, this file models only what has real,        │
// │ tested Rust types to mirror (vpay-core::state, vpay-core::failure,       │
// │ vpay-provider::Capabilities, vpay-ledger). It deliberately does NOT      │
// │ invent shapes for entities that exist only as prose in docs/flows/*.md   │
// │ with zero backing Rust type — provider_requests, webhook                 │
// │ events/endpoints, the job queue, idempotency keys, and Merchant. The     │
// │ "GAP" comments below explain exactly what's missing and why it was       │
// │ left out rather than invented. See docs/status.md for the                │
// │ authoritative done/not-done list.                                        │
// └──────────────────────────────────────────────────────────────────────────┘

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// --- enums -------------------------------------------------------------
// Every enum below is a direct transcription of a real, tested Rust enum —
// variant-for-variant, in the enum's #[serde(rename_all = "snake_case")]
// wire form, so IntentStatus::RequiresPaymentMethod and this schema's
// requires_payment_method are one signifier, not two that can drift.

// backends/crates/vpay-core/src/state.rs — ProviderFlow
enum ProviderFlow {
  push
  redirect
}

// backends/crates/vpay-core/src/state.rs — IntentStatus. Note there is no
// `failed` variant: docs/flows/payment-lifecycle.md's own state diagram
// labels its "failed" box as an alias for
// "requires_payment_method + last_payment_error" — a rail-reported failure
// returns the intent to requires_payment_method, it does not add a state.
enum IntentStatus {
  requires_payment_method
  requires_action
  processing
  succeeded
  canceled
}

// backends/crates/vpay-core/src/state.rs — ChargeState. Charge, unlike
// PaymentIntent, does have a real terminal `failed`.
enum ChargeState {
  submitting
  submitted
  pending
  unresolved
  succeeded
  failed
}

// backends/crates/vpay-core/src/failure.rs — FailureCode. Closed vocabulary
// by design ("this vocabulary is closed and owned by the core").
enum FailureCode {
  insufficient_funds
  payer_timeout
  payer_declined
  invalid_payer
  payer_limit_reached
  payer_account_blocked
  invalid_payee
  payee_account_blocked
  provider_account_blocked
  provider_unavailable
  provider_error
}

// backends/crates/vpay-ledger/src/lib.rs — AccountKind
enum AccountKind {
  merchant_payable
  payer_clearing
  platform_fee_revenue
}

// backends/crates/vpay-ledger/src/lib.rs — Direction
enum Direction {
  debit
  credit
}

// --- reference data ------------------------------------------------------

model Currency {
  code String @id @iso4217 @db_enforce // 'XAF', 'EUR' — real DB CHECK, verified below
  exponent Int @range(min: 0, max: 4) @db_enforce // docs/flows/money.md: a property of the currency, not the environment

  payment_intents PaymentIntent[] @relation(fields: [code], references: [currency_code])
  charges Charge[] @relation(fields: [code], references: [currency_code])
  ledger_entries LedgerEntry[] @relation(fields: [code], references: [currency_code])
}

model Provider {
  code String @id @length(min: 1, max: 64) @db_enforce // 'mtn_momo' | 'orange_money'
  display_name String @length(min: 1, max: 128)
  flow ProviderFlow
  supports_refunds Boolean @default(false)
  supports_partial_refunds Boolean @default(false)
  delivers_callbacks Boolean @default(false)
  requires_ip_allowlist Boolean @default(false)
  enabled Boolean @default(true)

  charges Charge[] @relation(fields: [code], references: [provider_code])

  // GAP — no DB-level coherence CHECK expressible in THIS GRAMMAR.
  // backends/crates/vpay-provider/src/lib.rs:28-34 (Capabilities::is_coherent)
  // enforces `supports_partial_refunds ⇒ supports_refunds` in Rust. This
  // claim cannot be honoured by CrateStack's grammar: @db_enforce
  // (crates/cratestack-migrate/src/convert/checks.rs) only promotes a
  // single field's @range/@length/@iso4217 validator to a CHECK. There is
  // no @@check(expr) or any other cross-column boolean constraint
  // implemented in cratestack-parser today — `grep -rn '"check"\|db_enforce'
  // crates/cratestack-parser/src` turns up nothing beyond the three
  // eligible validators. (The framework's own ADR 0004 prose mentions
  // "hand-written @@check constraints" as if the syntax existed; it does
  // not appear anywhere in the parser or its tests — that ADR text
  // describes something unimplemented, not something this schema failed
  // to use.) This invariant remains Rust-only in THIS FILE until the
  // grammar grows a general CHECK escape hatch.
  //
  // UPDATE: raw SQL has no such limitation, and the invariant is now real —
  // see `CONSTRAINT partial_refunds_imply_refunds` in
  // backends/migrations/0002_create-providers.sql, proven to fire by
  // partial_refunds_without_refunds_is_rejected_by_the_database in
  // backends/tests/integration/tests/postgres_smoke.rs. The migrations, not
  // this file, are the authoritative schema for this constraint; this GAP
  // is about what THIS grammar can express, not about what the database
  // enforces.
}

// --- payments --------------------------------------------------------------

model PaymentIntent {
  id String @id @length(min: 1, max: 64)
  merchant_id String @length(min: 1, max: 128)
  livemode Boolean
  amount Int @range(min: 0) @db_enforce
  amount_received Int @default(0) @range(min: 0) @db_enforce
  amount_refunded Int @default(0) @range(min: 0) @db_enforce
  amount_refund_pending Int @default(0) @range(min: 0) @db_enforce
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])
  status IntentStatus
  last_payment_error String? @length(max: 512) // docs/flows/payment-lifecycle.md: populated when a rail-reported failure returns the intent to requires_payment_method
  payment_method_types Json // NOT String[] — see note below
  created_at DateTime @default(dbgenerated())

  charges Charge[] @relation(fields: [id], references: [payment_intent_id])

  @@index([merchant_id])

  // `payment_method_types Json`, not `String[]`: verified with the real CLI
  // that a list-arity scalar on a datasource-backed model is a *parse-time
  // rejection*, not a style preference —
  //   $ cratestack check --schema <fixture with `tags String[]`>
  //   Error: list-valued type `String[]` is not supported on a
  //   database-backed model — there is no SQL bind representation for a
  //   list-valued scalar ... (cratestack-parser/src/tests_list_arity.rs
  //   documents the same rejection as a regression test for issue #229)
  // This is the one place the original invented-syntax file would have
  // failed outright had anyone tried to run it through the real tool.

  // GAP — merchant_id has no @relation. There is no Merchant model in
  // this schema because there is no `struct Merchant` anywhere in
  // backends/crates/*/src (checked by grep — zero hits). Inventing one to
  // make this field "look" referentially sound would be exactly the
  // plausible-but-fabricated failure mode this rewrite exists to avoid.

  // GAP — same missing CHECK class as Provider, above, in THIS GRAMMAR, for
  // the over-refund invariant: amount_refunded + amount_refund_pending <=
  // amount is a cross-column arithmetic CHECK; @db_enforce cannot express
  // it for the same reason noted on Provider. In this file it remains
  // enforced only by Money's type-level guarantees in vpay-core
  // (docs/flows/money.md invariant 3) at the moment of construction.
  //
  // UPDATE: raw SQL has no such limitation — see `CONSTRAINT
  // no_over_refund` in backends/migrations/0003_create-payment-intents.sql,
  // proven to fire by over_refund_is_rejected_by_the_database in
  // backends/tests/integration/tests/postgres_smoke.rs. See that migration's
  // own comment for exactly what concurrency guarantee this does and does
  // not provide (it rejects any single committed write that would go
  // over-refunded, including racing concurrent UPDATEs via Postgres's
  // ordinary row-lock-then-recheck behaviour; it is not the same thing as
  // an application-level SELECT ... FOR UPDATE, which does not exist here).
  // The migrations, not this file, are the authoritative schema for this
  // constraint.
}

model Charge {
  id String @id @length(min: 1, max: 64)
  payment_intent_id String @unique @length(min: 1, max: 64) // "one charge per intent, forever" — a plain unique index, exactly as AGENTS.md and docs/flows/payment-lifecycle.md describe. This one IS fully expressible and is now real.
  payment_intent PaymentIntent @relation(fields: [payment_intent_id], references: [id])
  provider_code String
  provider Provider @relation(fields: [provider_code], references: [code])
  provider_reference_id Uuid // matches vpay_provider::ChargeRef::reference_id: Uuid exactly — the original file had this as `String`
  provider_ref_extra Json? // vpay_provider::RefExtra = BTreeMap<String, String>; rail key material (pay_token)
  redirect_url String? @uri
  state ChargeState
  amount Int @range(min: 0) @db_enforce
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])
  payer_ref String? @sensitive // null on redirect rails
  payer_ref_masked String?
  failure_code FailureCode?
  failure_raw String? @length(max: 2000) @sensitive // vpay_provider::ChargeStatus::Failed carries both `code` AND `raw` — the original file captured only failure_code and silently dropped the raw provider message
  created_at DateTime @default(dbgenerated())

  ledger_transactions LedgerTransaction[] @relation(fields: [id], references: [charge_id])

  @@index([state])

  // GAP — provider_requests, the table docs/flows/crash-safety.md
  // requires to disambiguate a crashed `submitting` charge ("Row exists,
  // status_code IS NULL" vs "no row at all" vs "row has a status code"), is
  // not modeled. `grep -rn "ProviderRequest" backends/crates/*/src` is
  // empty — no Rust type exists to mirror. This is the single biggest
  // structural gap in this file relative to the crash-safety design, and it
  // is left out rather than invented from prose alone.
}

// --- ledger ------------------------------------------------------------
// Mirrors backends/crates/vpay-ledger/src/lib.rs field-for-field. That
// crate's types and its balancing invariant ARE implemented and tested
// (docs/status.md: "🟡 Types and validate() done + 3 tests. Persistence not
// started") — unlike provider_requests/webhooks/jobs above, there is real,
// tested Rust code this half of the file mirrors, which is the line this
// rewrite draws between "design sketch of a tested type" and "invented
// shape for a concept nobody has written a struct for yet". No migration or
// SQLx query in this repo writes to either table below; this is the
// intended persistence shape, not evidence persistence exists.

model LedgerTransaction {
  id Cuid @id @default(dbgenerated())
  charge_id String
  charge Charge @relation(fields: [charge_id], references: [id])
  created_at DateTime @default(dbgenerated())

  entries LedgerEntry[] @relation(fields: [id], references: [transaction_id])

  // GAP — docs/flows/ledger.md invariant 1, "per transaction: SUM(debit) =
  // SUM(credit), per currency", cannot be a CHECK constraint under *any*
  // schema grammar, CrateStack included: SQL CHECK constraints evaluate one
  // row at a time, and this invariant is an aggregate over every
  // LedgerEntry row sharing a transaction_id. Expressing it at the database
  // layer needs a trigger (not something .cstack generates) or, as today,
  // application enforcement — exactly what
  // vpay_ledger::Transaction::validate() already does, tested by
  // a_capture_with_a_fee_balances / an_unbalanced_transaction_is_rejected.
}

model LedgerEntry {
  id Cuid @id @default(dbgenerated())
  transaction_id Cuid
  transaction LedgerTransaction @relation(fields: [transaction_id], references: [id])
  account AccountKind
  direction Direction
  amount Int @range(min: 0) @db_enforce
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])

  // GAP — vpay_ledger::AccountKind has exactly 3 variants (MerchantPayable,
  // PayerClearing, PlatformFeeRevenue) with no per-merchant dimension, and
  // this table mirrors that Rust type exactly. But docs/flows/ledger.md
  // invariant 2 is "per merchant: balance(merchant_payable) = Σ captures −
  // Σ fees − Σ refunds" — a query this table cannot answer as modeled,
  // because nothing here says *which* merchant a merchant_payable posting
  // belongs to. That is a real gap in the Rust type this schema mirrors,
  // not something to paper over by adding a merchant_id column the Rust
  // side doesn't have.
}

// --- operations ----------------------------------------------------------

// The operator kill-switch (backends/migrations/0012_create-disabled-clients.sql).
//
// THE FIRST MODEL IN THIS FILE THAT IS COMPILED RATHER THAN SKETCHED. It is
// the one `vpay-db`'s private `mod schema` reads through CrateStack today —
// `DisabledClients::is_client_disabled` runs `find_unique(...).run(ctx)`
// against it — so unlike every other declaration here, getting a column
// wrong is a runtime decode failure rather than a design note. It was chosen
// to go first because it is the only vpay table whose every column type is
// already inside `cratestack-migrate`'s `map_scalar` (TEXT, TIMESTAMPTZ,
// TEXT), it carries no CHECK constraint, and it names no enum: the migration
// needed to model it is empty. See docs/reference/vpay-db.md § CrateStack.
//
// `@@allow("read", ...)` and NOTHING ELSE, deliberately. A model with no
// `@@allow` is deny-by-default and its generated reads return zero rows —
// the policy is compiled into the SQL `WHERE` clause, so the read succeeds
// and finds nothing rather than failing. That is why the parity test in
// `vpay-db/tests/repositories.rs` compares the CrateStack read against a
// direct sqlx read of the same row instead of merely asserting it does not
// error: deleting this line makes the kill-switch answer "not disabled" for
// every client, which is the failure this whole adoption most has to be
// unable to make silently.
//
// `auth().isSystem()` rather than `auth() != null`: `vpay-db` reaches this
// table as trusted in-process code, never on behalf of a request, and
// `SystemContext` is deliberately unreachable from a request-derived
// context (`cratestack-core`'s context/system.rs — there is no
// `From<CratestackContext>`), so the predicate a system read satisfies
// cannot be satisfied by anything an HTTP caller controls.
//
// The two WRITES moved to CrateStack on 2026-09-06, which is what the three
// extra `@@allow` arms below are for — this comment said "still raw sqlx"
// until then. `disable_client` is `.upsert(..).run(ctx)` and needs BOTH
// `create` and `update`: `cratestack-sqlx`'s `upsert_exec.rs` pre-flights
// the create policy on every call and `upsert_resolve.rs` gates the update
// branch separately, so a model with only one of the two fails whichever
// branch it did not name. `enable_client` is `.delete_many(..).run(ctx)`
// and needs `delete`.
//
// Four arms rather than one `@@allow("all", ...)`, deliberately — but NOT
// for the reason this comment gave until the review of 2026-09-06.
// `cratestack-macros`' `parse_policy_expression` treats `"all"` as matching
// every action, so one line would work, and it would grant exactly what
// these four grant and nothing more. This comment claimed `"all"` "would
// also grant `list` and `detail`"; it would not grant them *additionally*,
// because `@@allow("read", ...)` already does. `model/descriptor.rs:45-47`
// compiles the `read` arm into BOTH `&["list", "read"]` and
// `&["detail", "read"]`, which is asserted in
// `disabled_clients.rs::every_action_this_crate_calls_has_an_allow_arm`
// (`detail_allow_policies.len() == 1` with no `detail` arm declared here).
//
// The real and only reason for four lines is that each can be deleted on
// its own, and the four runtime effects are not alike:
//
//   create  -> LOUD  (`CratestackError::Forbidden` -> `PersistenceError::
//                     Denied` -> `Category::Internal`), on every call
//   update  -> LOUD, but only on the conflict branch — a first disable of
//              a given client succeeds and the second fails
//   delete  -> SILENT: `enable_client` goes through `delete_many`, whose
//              policy clause is part of the `WHERE`, so a missing arm
//              removes zero rows and returns `Ok`
//   read    -> SILENT, the same way, and the dangerous direction: every
//              revoked client is admitted again
//
// A wildcard would have made that asymmetry unmeasurable. All four
// mutations were run twice — by the change and again by its review —
// against a real Postgres; docs/status.md carries the dated row and
// docs/plans/exp16-notes/ the transcripts.
model DisabledClient {
  client_id String @id
  // `@default(now())`, not `@default(dbgenerated())`, and the difference is
  // measured rather than stylistic. `migrate baseline` introspects the live
  // column's `pg_get_expr(...)` as `ColumnDefault::Function("now()")`;
  // `@default(now())` converts to the same thing, so the two compare equal
  // and this table leaves the drift report entirely — 86 changes over 17
  // relations became 85 over 16. `@default(dbgenerated())` converts to
  // `ColumnDefault::DbGenerated`, which never equals a `Function`, so it
  // leaves one permanent `column disabled_at default value differs` line and
  // the total stays at 86. Both were run; see docs/plans/exp14-notes/opus.md.
  disabled_at DateTime @default(now())
  reason String?

  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())
  @@allow("delete", auth().isSystem())
}

// --- intentionally not modeled ------------------------------------------
//
// The following are named in docs/flows/*.md and marked ⛔ "not started" in
// docs/status.md, with zero corresponding Rust struct anywhere in
// backends/crates/*/src (checked by grep for each name below). Modeling
// their column shapes from doc prose alone would be inventing a plausible
// schema for code that does not exist — the exact failure mode this file
// was rewritten to stop doing:
//
//   - webhook endpoints, the event/outbox pair, and webhook_delivery
//     (docs/flows/webhooks.md's two-step outbox — fanout_state, retries)
//   - the job queue and its dedupe_key (docs/flows/reconciler.md)
//   - idempotency keys (docs/status.md: ⛔, no design doc field list either)
//   - Merchant (referenced only as a bare merchant_id string everywhere
//     above — see the GAP note on PaymentIntent.merchant_id)
//
// Add each once its crate has a real, tested type to mirror — the same bar
// this file just applied to the ledger models above.
