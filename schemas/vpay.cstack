// vpay — CrateStack schema
//
// ┌──────────────────────────────────────────────────────────────────────────┐
// │ STATUS: PARTLY COMPILED SINCE 2026-09-06 — ONE MODEL IS REAL, THE        │
// │ REST IS A DESIGN SKETCH                                                  │
// │                                                                          │
// │ This file used to say "NOT WIRED IN" and "EXCLUDED FROM THE BUILD        │
// │ GRAPH". Both stopped being true on 2026-09-06:                           │
// │ backends/crates/vpay-db/src/schema.rs now invokes                        │
// │ include_server_schema!("../../../schemas/vpay.cstack", db = Postgres),   │
// │ so EVERY declaration below is compiled by rustc into `vpay-db` on        │
// │ every build, and a syntax or type error here is a build failure          │
// │ rather than a gate failure. The generated module is PRIVATE to           │
// │ `vpay-db` and re-exported nowhere (ADR-0016 standard 5; `cargo xtask     │
// │ verify-repositories` fails if that changes).                             │
// │                                                                          │
// │ Compiled is not the same as used, and the difference matters more        │
// │ than usual here. FIVE models have queries running through them, all      │
// │ of them since 2026-09-06: `DisabledClient` (all three methods —          │
// │ `find_unique(...).run(ctx)`, `upsert(...).run(ctx)` and                  │
// │ `delete_many().where_(...).run(ctx)`), `Currency`                        │
// │ (`find_unique(...).for_update()` then `upsert(...)`, both `run_in_tx`    │
// │ on boot step 4's transaction) and `Provider` (`upsert(...).run_in_tx`,   │
// │ which migration 0033 is what made possible — see the note on that        │
// │ model), plus `WebhookDelivery` and `Event` (the outbox: `upsert(...)     │
// │ .do_nothing()` and `update_many(...)`, both `run_in_tx` on the fan-out   │
// │ transaction — see those models). This box said "exactly ONE model"       │
// │ until the currencies, providers and outbox passes moved. Every other     │
// │ model below is still a design                                            │
// │ sketch that happens to be type-checked by a compiler as well as by the   │
// │ CLI; no code reads or writes through any of them, and several do not     │
// │ match the live table at all (see the drift list). docs/status.md is      │
// │ the authoritative done/not-done list.                                    │
// │                                                                          │
// │ The content was rewritten against the real grammar in 2026-09, field     │
// │ by field against cratestack-parser's own test suite rather than          │
// │ guessed from an overview page. (An earlier note blamed                   │
// │ "cratestack.dev/docs 404s publicly". Corrected 2026-09-05: /docs does    │
// │ 404, but the docs are at cratestack.dev/getting-started/quickstart,      │
// │ /guides/*, /architecture/*, /reference/* and /tooling/*.)                │
// │                                                                          │
// │ TWO INDEPENDENT THINGS CHECK THIS FILE, and they are not the same        │
// │ check. `just check-schema` runs                                          │
// │   $ cratestack check --schema schemas/vpay.cstack                        │
// │   schema OK: schemas/vpay.cstack                                         │
// │ as the seventh gate in `just verify`, at the CLI version pinned as       │
// │ `cratestack_version` in the justfile — 0.12.0 today, the same version    │
// │ `Cargo.toml` pins the LIBRARY to, which is why the two cannot answer     │
// │ about different grammars. `cargo build` is the other: the macro          │
// │ parses this file with `cratestack-parser` and fails the build on         │
// │ anything the CLI would reject, and on some things it would not           │
// │ (composite `@@id`, list-arity scalars on a database-backed model).       │
// │                                                                          │
// │ The 0.10 grammar added block attributes this file does not use (@@sql,   │
// │ @@embedded_sql, @@server_sql for views; @@paged, @@subscribe, @@audit,   │
// │ @@soft_delete). 0.12.0 still has no @@check(expr) — no hit for           │
// │ '@@check' anywhere in cratestack-parser 0.12.0 or cratestack-migrate     │
// │ 0.12.0, and the latter's convert/checks.rs still promotes a CHECK only   │
// │ from @db_enforce on a single field — so the GAP notes on cross-column    │
// │ CHECKs below remain accurate. (KNOWN_ATTRIBUTE_NAMES was cited here      │
// │ too until 2026-09-05; it is a typo-suggestion table and lists no         │
// │ 'index' either, so it proves nothing. See docs/status.md.)               │
// │                                                                          │
// │ THE GAP TO THE MIGRATIONS IS MEASURED, AND IT MUST MOVE WHEN THIS        │
// │ FILE GROWS. `cratestack migrate baseline --strict` runs against a        │
// │ real, fully migrated vpay Postgres in postgres_smoke.rs::the_cstack_     │
// │ schema_drifts_from_the_migrations_by_a_measured_amount, which pins the   │
// │ count, the number of relations it is spread over, and the exact set of   │
// │ tables the database has and this file does not. 86 changes over 17       │
// │ relations on 2026-09-05; 85 over 16 when `DisabledClient` landed on      │
// │ 2026-09-06 and `disabled_clients` left the report entirely; **84 over    │
// │ 16 since migration 0032** widened `currencies.exponent`. Migration       │
// │ 0033 moved it by ZERO and had to: a column default costs drift only      │
// │ when the two sides disagree, so dropping the five `@default(...)`        │
// │ here WITHOUT that migration would have made it 89. That is a             │
// │ comparison, not a migration source: nothing                              │
// │ generates DDL from this file and it drives no migration —                │
// │ `backends/migrations/*.sql` remains the authoritative schema.            │
// │                                                                          │
// │ What the measurement added to the GAP notes below: the two               │
// │ cross-column CHECKs are not just inexpressible here, they are            │
// │ INVISIBLE to `migrate baseline` — all ten multi-column CHECKs in the     │
// │ database are — so a clean --strict run would say nothing about either    │
// │ of them. That is CrateStack's own documented gap: cratestack-migrate     │
// │ 0.12.0's src/introspect/postgres/mod.rs lists "Multi-column and          │
// │ zero-column CHECK constraints are skipped" because AddCheck ties to      │
// │ exactly one column. So the ask below is not only @@check(expr) in the    │
// │ grammar — it needs an IR op that is not single-column and                │
// │ introspection that reads array_length(conkey, 1) > 1, or a parsed        │
// │ @@check would still be invisible to migrate baseline and migrate diff.   │
// │ See docs/status.md, "The measured drift", and                            │
// │ docs/plans/exp13-notes/opus.md.                                          │
// │                                                                          │
// │ One more thing the rewrite had to learn the hard way: `cratestack        │
// │ check` rejects column-aligned field declarations (multiple spaces        │
// │ between a field name and its type) with a confusing "invalid type        │
// │ reference" error that points at the wrong token entirely. Every field    │
// │ below is therefore single-spaced, matching the real project's own        │
// │ example schemas — not a style choice, a parser constraint.               │
// │                                                                          │
// │ Apart from `DisabledClient`, this file models only what has real,        │
// │ tested Rust types to mirror (vpay-core::state, vpay-core::failure,       │
// │ vpay-provider::Capabilities, vpay-ledger). It deliberately does NOT      │
// │ invent shapes for entities that exist only as prose in docs/flows/*.md   │
// │ with zero backing Rust type — provider_requests, webhook                 │
// │ events/endpoints, the job queue, idempotency keys, and Merchant. The     │
// │ "GAP" comments below explain exactly what's missing and why it was       │
// │ left out rather than invented. See docs/status.md for the                │
// │ authoritative done/not-done list.                                        │
// └──────────────────────────────────────────────────────────────────────────┘

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// --- enums -------------------------------------------------------------
// Every enum below is a direct transcription of a real, tested Rust enum —
// variant-for-variant, in the enum's #[serde(rename_all = "snake_case")]
// wire form, so IntentStatus::RequiresPaymentMethod and this schema's
// requires_payment_method are one signifier, not two that can drift.

// backends/crates/vpay-core/src/state.rs — ProviderFlow
enum ProviderFlow {
  push
  redirect
}

// backends/crates/vpay-core/src/state.rs — IntentStatus. Note there is no
// `failed` variant: docs/flows/payment-lifecycle.md's own state diagram
// labels its "failed" box as an alias for
// "requires_payment_method + last_payment_error" — a rail-reported failure
// returns the intent to requires_payment_method, it does not add a state.
enum IntentStatus {
  requires_payment_method
  requires_action
  processing
  succeeded
  canceled
}

// backends/crates/vpay-core/src/state.rs — ChargeState. Charge, unlike
// PaymentIntent, does have a real terminal `failed`.
enum ChargeState {
  submitting
  submitted
  pending
  unresolved
  succeeded
  failed
}

// backends/crates/vpay-core/src/failure.rs — FailureCode. Closed vocabulary
// by design ("this vocabulary is closed and owned by the core").
enum FailureCode {
  insufficient_funds
  payer_timeout
  payer_declined
  invalid_payer
  payer_limit_reached
  payer_account_blocked
  invalid_payee
  payee_account_blocked
  provider_account_blocked
  provider_unavailable
  provider_error
}

// backends/crates/vpay-db/src/refunds.rs — the refund lifecycle. A native
// `refund_status` enum in the database until migration 0037 converted it to
// TEXT + `refunds_status_enum_check`, for the reason every enum on these
// tables was converted: CrateStack's generated row decoders read an enum
// column with `try_get::<String>()`, so a native enum column fails to decode
// on every read.
//
// `canceled` is in the vocabulary because migration 0017 put it there, not
// because anything reaches it: nothing in this repository writes a refund at
// all (`vpay_db::refunds` is two reads and no write, because
// `ProviderAdapter::refund` is `NotImplemented` on MTN and `Unsupported` on
// Orange). docs/status.md says so.
enum RefundStatus {
  pending
  succeeded
  failed
  canceled
}

// backends/crates/vpay-ledger/src/lib.rs — AccountKind
enum AccountKind {
  merchant_payable
  payer_clearing
  platform_fee_revenue
}

// backends/crates/vpay-ledger/src/lib.rs — Direction
enum Direction {
  debit
  credit
}

// --- reference data ------------------------------------------------------

// The second model in this file that is READ AND WRITTEN rather than
// sketched. `ConfigReconcile::reconcile` (boot step 4) runs its currency pass
// as `find_unique(code).for_update()` then `upsert(...)`, both `run_in_tx` on
// vpay's own transaction — see backends/crates/vpay-db/src/config_reconcile.rs.
//
// Migration 0032 is what made that possible, and it had to change the live
// table twice. `exponent` was `INT`: `Int` here always emits `int8`, and
// cratestack's introspector deliberately refuses to map `int4` back onto
// `Int` ("an `int4` column silently mapped to `Int` would make a live table
// that actually differs from the schema look identical to it"), so the column
// was invisible to `migrate baseline` — reported as "declared in the schema
// but does not exist in the live database". It is `BIGINT` now. And the two
// CHECKs below were named `code_is_iso4217_shape` and `exponent_in_range` by
// hand; the diff engine matches checks by NAME first (`diff/checks.rs`), so
// they are `currencies_code_iso4217_check` and
// `currencies_exponent_range_check` now, which is `naming.rs::check_name`'s
// `<table>_<column>_<validator>_check`.
//
// What that rename bought, measured with the drift test on 2026-09-06 and
// recorded because the answer is not the expected one: **nothing, in the
// count.** Introspection reports EVERY validator-derived CHECK as
// `CheckKind::Raw(<deparsed text>)` and never reconstructs `Iso4217` or
// `Range` from it (`ir/checks.rs`: "Rather than guess which validator (if
// any) produced it, introspection always reports it as opaque text"). Only
// `CheckKind::Enum` has a reconstructor. So a matching name turns two
// unrelated lines ("this CHECK is in the database and not the schema" plus
// "this one is in the schema and not the database") into a same-named
// drop-and-add pair, which is a clearer report and the same number. The
// count fell from 85 to 84 purely because of the `exponent` widening. Both
// halves are in docs/plans/exp17-notes/opus.md.
//
// Three `@@allow` arms, one per action `config_reconcile` actually calls:
// `read` for the `find_unique`, and `create` + `update` for the `upsert`,
// which pre-flights the create policy on every call and gates the conflict
// branch on the update one. No `delete` arm: nothing deletes a currency, and
// a reference row that a `DELETE` could reach is a foreign key waiting to
// break. `auth().isSystem()` for `DisabledClient`'s reason — `vpay-db` reads
// this table as trusted in-process code and `SystemContext` is unreachable
// from anything an HTTP caller controls.
model Currency {
  code String @id @iso4217 @db_enforce // 'XAF', 'EUR' — real DB CHECK, verified below
  exponent Int @range(min: 0, max: 4) @db_enforce // docs/flows/money.md: a property of the currency, not the environment

  payment_intents PaymentIntent[] @relation(fields: [code], references: [currency_code])
  charges Charge[] @relation(fields: [code], references: [currency_code])
  // Added with `model Refund` (S5). A back-reference carries no column and
  // emits no foreign key of its own (`convert/relations.rs` returns `None`
  // for a `List` field) — it is here because `cratestack-parser` requires
  // BOTH sides of a relation to declare `@relation(...)`, and `Refund`'s
  // owning side is what makes `refunds_currency_code_fkey` a foreign key the
  // schema declares rather than one the report proposes dropping.
  refunds Refund[] @relation(fields: [code], references: [currency_code])
  ledger_entries LedgerEntry[] @relation(fields: [code], references: [currency_code])

  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())
}

// `flow` is the FIRST of vpay's seven native Postgres enums to be converted
// to TEXT + CHECK, by migration 0032. It had to be: cratestack never emits a
// native `CREATE TYPE ... AS ENUM` on any backend, because its generated row
// decoders read an enum column with `try_get::<String>()` and `.parse()` —
// so a native enum column fails to decode on EVERY read through this layer
// (`emit/postgres/columns.rs`, upstream issue #228). The validation the type
// used to give is back as `providers_flow_enum_check`, the name
// `naming.rs::check_name(table, column, "enum")` generates, with the
// predicate Postgres deparses into the exact shape
// `introspect/postgres/check_pattern.rs::reconstruct_enum` reads back.
//
// The conversion is INVISIBLE to `migrate baseline`, measured on 2026-09-06,
// and that is worth stating because it is the mirror image of the
// multi-column-CHECK blind spot this file's header already records.
// `introspect/postgres/enums.rs` already synthesised `providers_flow_enum_check`
// out of `pg_enum` for the native column, and `resolve_column` projects a
// native enum and a TEXT column onto the same `Scalar("String")` — so the
// report said exactly the same four things about `providers` before and
// after. The one line it keeps saying, `column flow type differs (live:
// Scalar("String"), schema: Enum("ProviderFlow"))`, is permanent at 0.12.0
// and not a defect in this file: the enum's NAME has no catalog
// representation to recover it from, which `enums.rs`'s own doc comment
// calls out as documented lossiness. A drift report is not what proves this
// conversion worked; `a_provider_reads_through_cratestack_exactly_as_it_does_through_sqlx`
// in config_reconcile.rs is, and reverting the migration's `ALTER COLUMN
// flow TYPE TEXT` is what makes it fail.
//
// `read`, `create` and `update`, and NO `delete`, exactly like `Currency`
// above. The three write arms landed on 2026-09-06 in the commit that moved
// `config_reconcile`'s provider pass onto `upsert(...).run_in_tx(...)` — not
// before it, which is the rule the comment here used to state in its
// unsatisfied form ("add them in the commit that moves the write"). `delete`
// stays absent for `Currency`'s reason: every `charges` and
// `provider_requests` row references this table, and a rail that has ever
// taken money must stay nameable forever, so `reconcile` disables a dropped
// rail rather than removing it.
//
// The five capability booleans below carried `@default(...)` until the same
// day, and that is what had kept the provider pass on hand-written SQL:
// `cratestack-macros` drops every `@default(...)` field from both
// `Create{Model}Input` and `upsert_update_columns`, so the generated upsert
// could write only `code`, `display_name` and `flow`. See the note at the
// end of this model for what was decided and what it cost.
model Provider {
  code String @id @length(min: 1, max: 64) @db_enforce // 'mtn_momo' | 'orange_money'
  display_name String @length(min: 1, max: 128)
  flow ProviderFlow
  supports_refunds Boolean
  supports_partial_refunds Boolean
  delivers_callbacks Boolean
  requires_ip_allowlist Boolean
  enabled Boolean

  charges Charge[] @relation(fields: [code], references: [provider_code])

  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())

  // GAP — no DB-level coherence CHECK expressible in THIS GRAMMAR.
  // backends/crates/vpay-provider/src/lib.rs:28-34 (Capabilities::is_coherent)
  // enforces `supports_partial_refunds ⇒ supports_refunds` in Rust. This
  // claim cannot be honoured by CrateStack's grammar: @db_enforce
  // (crates/cratestack-migrate/src/convert/checks.rs) only promotes a
  // single field's @range/@length/@iso4217 validator to a CHECK. There is
  // no @@check(expr) or any other cross-column boolean constraint
  // implemented in cratestack-parser today — `grep -rn '"check"\|db_enforce'
  // crates/cratestack-parser/src` turns up nothing beyond the three
  // eligible validators. (The framework's own ADR 0004 prose mentions
  // "hand-written @@check constraints" as if the syntax existed; it does
  // not appear anywhere in the parser or its tests — that ADR text
  // describes something unimplemented, not something this schema failed
  // to use.) This invariant remains Rust-only in THIS FILE until the
  // grammar grows a general CHECK escape hatch.
  //
  // UPDATE: raw SQL has no such limitation, and the invariant is now real —
  // see `CONSTRAINT partial_refunds_imply_refunds` in
  // backends/migrations/0002_create-providers.sql, proven to fire by
  // partial_refunds_without_refunds_is_rejected_by_the_database in
  // backends/tests/integration/tests/postgres_smoke.rs. The migrations, not
  // this file, are the authoritative schema for this constraint; this GAP
  // is about what THIS grammar can express, not about what the database
  // enforces.

  // WHY THE FIVE CAPABILITY BOOLEANS CARRY NO `@default(...)`, when migration
  // 0002 gave the live columns one — resolved 2026-09-06 (maintainer decision
  // D7), and this note is the reason it must stay resolved in BOTH files.
  //
  // `cratestack-macros`' `model/inputs.rs::create_input_fields` and
  // `model/descriptor/columns.rs`'s `upsert_update_columns` both filter out
  // every field carrying `@default(...)` ("server-owned identity bindings
  // ... clobbering these on update would turn upsert into 'take ownership of
  // any row I name'"). While the five were here, `preview_sql` rendered
  //
  //   INSERT INTO providers (code, display_name, flow) VALUES ($1, $2, $3)
  //   ON CONFLICT (code) DO UPDATE SET display_name = EXCLUDED.display_name,
  //                                    flow = EXCLUDED.flow
  //
  // — `supports_refunds`, `supports_partial_refunds`, `delivers_callbacks`,
  // `requires_ip_allowlist` and `enabled` in neither list. Boot step 4 would
  // have written the column defaults instead of the deployment's
  // configuration and would never have carried a capability change to an
  // existing row: a rail an operator had just disabled would come back
  // enabled. That is why the provider pass stayed hand-written SQL until the
  // defaults went (docs/plans/exp17-notes/opus.md § 3).
  //
  // THE TWO HALVES ARE ONE CHANGE. Removing the five `@default(...)` from
  // this file WITHOUT `ALTER TABLE providers ALTER COLUMN ... DROP DEFAULT`
  // takes the drift report from 84 changes to 89 — five
  // `column ... default value differs` lines on `providers`, measured
  // 2026-09-06. `backends/migrations/0033_providers-drop-capability-defaults.sql`
  // is the other half, and it argues the DDL side of the trade: the only
  // writer of these columns is `reconcile`, which always writes all five, so
  // a column default cannot help that writer — it can only invent a
  // capability for a writer that forgot one. What the drop costs is that a
  // hand-written `INSERT` must now name all eight columns; that is a refusal
  // rather than a silent difference, and it is pinned by
  // `a_hand_written_provider_insert_must_now_name_every_capability_column`.
  //
  // What now renders, and what pins it:
  // `the_provider_upsert_carries_all_eight_columns` in
  // backends/crates/vpay-db/src/config_reconcile.rs. Put a `@default(...)`
  // back on any of the five and NEITHER that test nor the drift report is
  // what stops you: the field disappears from `CreateProviderInput` and
  // `reconcile`'s struct literal names one that no longer exists, so the
  // crate does not compile and no test runs at all —
  // `error[E0560]: struct \`inputs::CreateProviderInput\` has no field named
  // \`supports_refunds\``, measured 2026-09-06. (`E0063`, "missing field", is
  // the error going the other way, and this comment named it until the
  // review pass corrected it.)
}

// --- payments --------------------------------------------------------------

model PaymentIntent {
  // S5 (2026-09-07) rewrote this model field-for-field against the live
  // table. It had been a design sketch since the file was written and had
  // drifted badly: it declared `last_payment_error String?`, a column
  // migration 0014 DROPPED, and knew nothing of `seq`, `metadata`,
  // `description`, `customer_id`, `client_secret_suffix` or `updated_at`.
  // Nothing read or wrote through it, so nothing noticed — which is exactly
  // the hazard `EXPECTED_DRIFT_CHANGES` exists to make expensive.
  //
  // WHAT IS DELIBERATELY ABSENT: `payment_method_types` and `metadata`, both
  // `JSONB`. They are not modelled and no query on this table runs through
  // CrateStack because of them — see the block comment below.
  id String @id @length(min: 1, max: 64)
  // `GENERATED ALWAYS AS IDENTITY` (migration 0014); `model Customer.seq`'s
  // trade, unchanged. An identity column carries no `pg_attrdef` default and
  // introspection reads only that, so this line costs one permanent
  // `column `seq` default value differs`; dropping the `@default(...)` would
  // make `seq` a REQUIRED field of `CreatePaymentIntentInput`, an explicit
  // value for a `GENERATED ALWAYS` column, which Postgres refuses.
  //
  // No `@unique`, though `payment_intents_seq_key` exists: `model Customer`
  // leaves `customers_seq_key` undeclared for the same reason and this file
  // follows the newest model rather than inventing a second convention.
  seq Int @default(dbgenerated())
  merchant_id String @length(min: 1, max: 128)
  livemode Boolean
  // NO `@db_enforce` on any of the four, and that is a change S5 made rather
  // than an omission. The live CHECKs are hand-named (`amount_non_negative`
  // and the three `amount_*_non_negative`), `@db_enforce` generates
  // `payment_intents_amount_range_check`, and `diff/checks.rs` matches by
  // name first — so promoting them emitted a drop-and-add PAIR (two lines)
  // where declaring the validator alone emits nothing beyond the `[safe]`
  // line the hand-named CHECK produces either way. `model Customer` records
  // the same measurement for its `@length`s. The validators are not inert:
  // `inputs.rs::validate_impl_tokens` builds `input.validate()` from them
  // regardless of `@db_enforce`.
  amount Int @range(min: 0)
  // The three running totals keep their `@default(...)`, and migration 0037
  // deliberately did NOT drop the DDL defaults to match 0033's `providers`
  // treatment. The trade is the opposite one here: `PaymentIntents::insert`
  // does not name these columns, no CrateStack write on this table moves, so
  // dropping the defaults would turn every intent creation into a `23502`
  // and buy nothing. Both sides carrying the default is what costs zero
  // drift (0033's own measurement).
  amount_received Int @default(0) @range(min: 0)
  amount_refunded Int @default(0) @range(min: 0)
  amount_refund_pending Int @default(0) @range(min: 0)
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])
  // TEXT + `payment_intents_status_enum_check` since migration 0037; a
  // native `intent_status` enum before it. An enum-typed field costs one
  // permanent `column `status` type differs (live: Scalar("String"), schema:
  // Enum("IntentStatus"))` line that no migration can remove — the enum's
  // NAME has no catalog representation to recover it from, which
  // `introspect/postgres/enums.rs`' own doc comment calls documented
  // lossiness. The CHECK itself converges, by name and by kind.
  status IntentStatus
  // Migration 0014's structured replacement for the `last_payment_error`
  // free-text column this model used to declare. `lpe_paired` keeps the two
  // halves together and is a cross-column CHECK, so it is invisible here and
  // to the report both.
  last_payment_error_code FailureCode?
  last_payment_error_message String? @length(max: 512)
  description String? @length(max: 1000)
  customer_id String?
  customer Customer? @relation(fields: [customer_id], references: [id])
  // A live payer credential (migration 0026). `@sensitive` is what
  // `is_sensitive_field` reads to redact a value from the audit log; nothing
  // in vpay audits today, and it is declared for the reason `model
  // Customer`'s identifiers are — the alternative is deciding retroactively
  // which credentials were safe to have written to a log.
  client_secret_suffix String @length(min: 32, max: 128) @sensitive
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  charges Charge[] @relation(fields: [id], references: [payment_intent_id])
  refunds Refund[] @relation(fields: [id], references: [payment_intent_id])
  checkout_sessions CheckoutSession[] @relation(fields: [id], references: [payment_intent_id])

  // `payment_intents_merchant_id_idx`, exactly. `index_name(table, cols,
  // None)` renders `<table>_<columns>_idx`, so this one-column declaration
  // and the live index are the same name and the same columns.
  // `payment_intents_merchant_seq_idx` is NOT declared: it is two columns
  // with a direction, which this grammar cannot express, and declaring
  // `@@index([merchant_id, seq])` would claim an index the database does not
  // have — `model Customer` carries the long form of that argument.
  @@index([merchant_id])

  // NO @@allow ARM, AND THAT IS THE POINT.
  //
  // A model with no `@@allow` is deny-by-default: every generated read
  // renders `FALSE` into its `WHERE` and every generated write refuses. That
  // is the correct declaration for this table today, because **no query on
  // `payment_intents` runs through CrateStack** and adding an arm would be a
  // standing permission for a call site that does not exist.
  //
  // WHY NO QUERY MOVED, and it is one reason rather than a list: every read
  // and every write in `vpay_db::payment_intents` returns a
  // `PaymentIntentRow`, and `PaymentIntentRow` carries `payment_method_types`
  // and `metadata` — two `JSONB` columns this model does not declare and
  // must not. `Value::from_plain_json` routes every JSON number through
  // `Number::as_i64()` with an `as_f64().unwrap_or_default()` fallback
  // (cratestack-core 0.12.0 `value.rs:95-106`), so a `u64` above `i64::MAX`
  // anywhere inside a merchant's `metadata` comes back as a float. A
  // generated read that omitted the two columns would answer a struct the
  // repository cannot build, and a second statement to fetch them would be a
  // consistency window on the money path. `docs/reference/vpay-db.md`
  // § "The money tables: what moved, and what stays raw forever" is the long
  // form, and it names what would have to change upstream first.
  //
  // What migration 0037 bought, then, is not a moved query: it is that the
  // report compares this table column by column instead of reporting it as a
  // table it cannot see, and that a future query CAN decode `status` at all.

  // GAP — merchant_id has no @relation. There is no Merchant model in
  // this schema because there is no `struct Merchant` anywhere in
  // backends/crates/*/src (checked by grep — zero hits). Inventing one to
  // make this field "look" referentially sound would be exactly the
  // plausible-but-fabricated failure mode this rewrite exists to avoid.

  // GAP — the over-refund invariant, `amount_refunded +
  // amount_refund_pending <= amount`, is a cross-column arithmetic CHECK and
  // there is still no `@@check(expr)` in the 0.12.0 grammar. Raw SQL has no
  // such limitation: `CONSTRAINT no_over_refund` in
  // backends/migrations/0003_create-payment-intents.sql is real and is proven
  // to fire by `over_refund_is_rejected_by_the_database` in
  // backends/tests/integration/tests/postgres_smoke.rs. `migrate baseline`
  // cannot see it in either direction (`introspect_checks` selects
  // `array_length(c.conkey, 1) = 1`), so deleting it moves no drift line and
  // only that test notices. The migrations, not this file, are the
  // authoritative schema for it.
}

model Charge {
  // Rewritten field-for-field against the live table by S5, like
  // `PaymentIntent` above: it was missing `provider_txn_id` (migration 0021),
  // `return_url` (0019) and `updated_at` (0014).
  //
  // DELIBERATELY ABSENT: `provider_ref_extra`, `JSONB`, and the single reason
  // no query on this table moved either — see `PaymentIntent`'s block on the
  // same subject; every `charges` read and write returns a `ChargeRow`, and
  // `ChargeRow` carries it.
  id String @id @length(min: 1, max: 64)
  // NO `@unique`, and S5 removed the one that was here. The live index is
  // `one_charge_per_intent` (migration 0004); `@unique` renders
  // `index_name_unique(table, cols)` = `charges_payment_intent_id_key`, a
  // name the database does not have, so the declaration cost a drop-and-add
  // PAIR — a `[blocking] index ... is declared in the schema but does not
  // exist` line beside the `[safe] index one_charge_per_intent ... is not
  // declared` line that is there regardless. Two lines to describe one
  // index, one of them a claim about an index that does not exist.
  //
  // "One charge per intent, forever" (AGENTS.md) is unaffected: it is that
  // unique index, in migration 0004, and `a_second_charge_on_one_intent_is_
  // rejected_by_the_database` in postgres_smoke.rs is what proves it fires.
  payment_intent_id String @length(min: 1, max: 64)
  payment_intent PaymentIntent @relation(fields: [payment_intent_id], references: [id])
  provider_code String
  provider Provider @relation(fields: [provider_code], references: [code])
  // matches vpay_provider::ChargeRef::reference_id: Uuid exactly. `uuid` IS
  // in `map_scalar`, unlike `jsonb` — this column is compared.
  provider_reference_id Uuid
  // The rail's own identifier for the settled payment, written only by the
  // settlement transaction (migration 0021).
  provider_txn_id String? @length(min: 1, max: 128)
  redirect_url String? @uri
  // The merchant's own destination for a `/v1` confirm (migration 0019).
  // NOT rail material — that is `provider_ref_extra`, which this model does
  // not declare.
  return_url String? @uri
  // TEXT + `charges_state_enum_check` since migration 0037. See
  // `PaymentIntent.status` for the one permanent drift line an enum-typed
  // field costs and why no migration can remove it.
  state ChargeState
  amount Int @range(min: 0)
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])
  payer_ref String? @sensitive
  payer_ref_masked String?
  failure_code FailureCode?
  // vpay_provider::ChargeStatus::Failed carries both `code` AND `raw`.
  failure_raw String? @length(max: 2000) @sensitive
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  refunds Refund[] @relation(fields: [id], references: [charge_id])
  ledger_transactions LedgerTransaction[] @relation(fields: [id], references: [charge_id])

  // `charges_state_idx`, exactly (migration 0004).
  // `charges_live_idx` is NOT declared: it is PARTIAL, and a partial index is
  // what forced migration 0037 to drop and rebuild it around the
  // `ALTER COLUMN state TYPE TEXT`. `charges_provider_reference_idx` is two
  // columns. Neither is expressible, and both are named in their migrations.
  @@index([state])

  // No @@allow arm, for `PaymentIntent`'s reason and the same measured
  // blocker (`provider_ref_extra`). Deny-by-default is the honest
  // declaration for a model nothing queries.

  // GAP — provider_requests, the table docs/flows/crash-safety.md
  // requires to disambiguate a crashed `submitting` charge ("Row exists,
  // status_code IS NULL" vs "no row at all" vs "row has a status code"), is
  // not modelled, and is out of scope FOREVER unless a reason appears
  // (docs/status.md): `latest_submit_attempt`'s `sent_at DESC, id DESC`
  // ordering and its `status_code`/`responded_at` pairing have no delegate,
  // and `status_code` is `int4`, one of the six unmapped types.
}

model Refund {
  // New in S5, and the table is the one place in this file where "modelled"
  // buys the least: `vpay_db::refunds` is TWO READS AND NO WRITE, because
  // creating a refund needs `ProviderAdapter::refund` and that is
  // `NotImplemented` on MTN and `Unsupported` on Orange (docs/status.md).
  // The brief that produced this model asked for "refunds' create/get" to
  // move; there is no create to move, and saying so is the point.
  //
  // Neither read moves either, and for two independent reasons rather than
  // one: `RefundRow` carries `metadata`, which is `JSONB` and undeclared
  // here for `PaymentIntent`'s reason; and both reads are merchant-scoped
  // through a JOIN onto `payment_intents`, because `refunds` carries no
  // `merchant_id` of its own (migration 0017 argues why it should not). A
  // generated read filters columns of ONE table — `find_many` renders
  // `SELECT ... FROM refunds WHERE ...` and has no join — so the tenant
  // predicate could not be in the statement, and "the merchant-facing query
  // is merchant-scoped in SQL" is the rule this module exists to keep.
  id String @id @length(min: 1, max: 64)
  payment_intent_id String @length(min: 1, max: 64)
  payment_intent PaymentIntent @relation(fields: [payment_intent_id], references: [id])
  // Nullable: a refund is requested against an INTENT, and the intent may
  // have no charge row to attribute it to when the request arrives.
  charge_id String?
  charge Charge? @relation(fields: [charge_id], references: [id])
  // `@range(min: 1)`, not `min: 0`: the live CHECK is `amount_positive`
  // (`amount > 0`), stricter than the intent's and the charge's, because a
  // zero-amount refund moves no money and is a caller mistake rather than a
  // no-op to store. No `@db_enforce`, for the reason on
  // `PaymentIntent.amount`.
  amount Int @range(min: 1)
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])
  // TEXT + `refunds_status_enum_check` since migration 0037.
  status RefundStatus
  // The MERCHANT's free text ("duplicate", "requested_by_customer"), not
  // vpay's. Deliberately not an enum in the database either — closing this
  // vocabulary would reject reasons vpay has no business having an opinion
  // about — so it is a plain `String?` here too.
  reason String? @length(max: 512)
  failure_code FailureCode?
  failure_raw String? @length(max: 2000) @sensitive
  // The rail-facing reference, generated before the call
  // (docs/flows/crash-safety.md). NULL until a rail call is attempted, and
  // every stored value is NULL today because nothing attempts one.
  provider_reference_id Uuid?
  // What the rail charged US to execute the refund (migration 0031, issue
  // #46). NULL means the rail reported no fee; 0 means it reported the
  // movement was free, and the column has no DEFAULT so those stay
  // different. NOT WRITTEN BY ANY CODE IN THIS REPOSITORY.
  fee Int? @range(min: 0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  // Both live indexes from migration 0017, both one column, both named
  // `<table>_<column>_idx` — so both are expressible and declared.
  @@index([payment_intent_id])
  @@index([charge_id])

  // No @@allow arm: nothing queries this model. See `PaymentIntent`.

  // ABSENT: `metadata Json`. Also absent from the report in both directions,
  // which is the property that makes leaving it out free —
  // `introspect/postgres/types.rs::map_scalar` does not map `jsonb` back onto
  // any scalar, so an undeclared `jsonb` column is invisible, while declaring
  // `metadata Json` would add a `[blocking] column metadata is declared in
  // the schema but does not exist in the live database` line.
  //
  // GAP — `failure_paired` and `metadata_is_object` are cross-column and
  // `jsonb_typeof` CHECKs respectively; neither is expressible here and
  // neither is visible to the report. `refunds.sql`'s migration owns them.
}

model CheckoutSession {
  // New in S5, and the ONE table of the four with no `jsonb` column at all —
  // which is why it is the only one any query moved on. See
  // `vpay_db::checkout_sessions` for which four did and which did not.
  id String @id @length(min: 1, max: 64)
  // `GENERATED ALWAYS AS IDENTITY` (migration 0028). Same trade, same
  // permanent `default value differs` line, and no `@unique` for the same
  // reason as `PaymentIntent.seq`.
  seq Int @default(dbgenerated())
  merchant_id String @length(min: 1, max: 128)
  payment_intent_id String @length(min: 1, max: 64)
  payment_intent PaymentIntent @relation(fields: [payment_intent_id], references: [id])
  livemode Boolean
  // THE THREE CLOSED VOCABULARIES ARE `String`, NOT `.cstack` ENUMS, and
  // that is a deliberate difference from `PaymentIntent.status` three models
  // up.
  //
  // These columns were never native Postgres enums: migration 0028 created
  // them as TEXT plus the hand-named CHECKs `ui_mode_is_known`,
  // `status_is_known` and `payment_status_is_known`. Declaring them as enums
  // here would generate `checkout_sessions_status_enum_check` and the rest,
  // `diff/checks.rs` matches by name first, and the result would be a
  // drop-and-add pair per column PLUS the permanent `type differs` line an
  // enum-typed field carries — three lines each, where a plain `String`
  // leaves the one `[safe] CHECK ... is not declared` line the hand-named
  // constraint produces anyway. `events.type_is_a_documented_event` is left
  // hand-named for exactly this reason and this file follows it.
  //
  // Renaming the three constraints in migration 0037 to converge was
  // considered and rejected: the measured lesson from 0032's two `currencies`
  // renames is that a CHECK rename moves the count by ZERO, and `vpay-db`
  // carries all three as `String` regardless, so a generated Rust enum would
  // be a type nothing wants.
  ui_mode String
  status String
  payment_status String
  // `@uri` and the `@length(max: 2048)` mirror migration 0028's three
  // `*_is_a_bounded_web_url` CHECKs, which are scheme tests and therefore
  // hand-written: no validator expresses "starts with http:// or https://".
  // No `@db_enforce` on any of them.
  success_url String? @uri @length(max: 2048)
  cancel_url String? @uri @length(max: 2048)
  return_url String? @uri @length(max: 2048)
  customer_id String?
  customer Customer? @relation(fields: [customer_id], references: [id])
  // NOT A SECRET: a publishable key names a tenant and authorises nothing,
  // and it is rendered into a merchant's own public checkout page by
  // construction. No `@sensitive`, unlike the two below it — migration 0028
  // argues the distinction at length.
  publishable_key String @length(min: 4, max: 128)
  // Both payer credentials, and both `@sensitive` for
  // `PaymentIntent.client_secret_suffix`'s reason.
  client_secret_suffix String @length(min: 32, max: 128) @sensitive
  return_token String @length(min: 32, max: 128) @sensitive
  // A stored instant rather than a computed one, so the horizon a session
  // was created under survives a change to the 24-hour constant. NO
  // `@default(...)`: the column has none, and the writer supplies it.
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  // NO @@index AT ALL, and all six live indexes are named in migrations 0028,
  // 0030 and 0034 instead. Five of the six are two columns with a direction
  // or are partial, and the sixth (`checkout_sessions_seq_key`) is the unique
  // index on `seq` that `model Customer` also leaves undeclared. Declaring
  // any of them would claim an index the database does not have.

  // `read` AND NOTHING ELSE — the one action `vpay_db::checkout_sessions`
  // calls through this model, and the four reads that call it are the only
  // CrateStack queries on any money table.
  //
  // WHAT A MISSING `read` ARM COSTS, and it is the SILENT direction: a read
  // policy is compiled into the statement's own `WHERE`
  // (`query/support/policy.rs::push_allow_policy_query` renders the literal
  // `FALSE` for an empty allow list), so deleting this line does not raise —
  // it makes every session read as absent. `GET /v1/checkout/sessions/{id}`
  // would answer 404 for a session that exists, the confirm path's
  // `find_latest_by_intent` would see none, and nothing would log an error.
  //
  // Two tests catch it and they catch it two ways.
  // `every_action_this_module_calls_has_an_allow_arm` in
  // `vpay-db/src/checkout_sessions.rs` asserts the slot is occupied with no
  // container, in milliseconds; the container cases in
  // `vpay-db/tests/repositories.rs` and the `checkout_sessions` integration
  // suite fail on the row.
  //
  // `auth().isSystem()` and not `auth() != null`: `SystemContext` is the only
  // producer of a context that satisfies it, it has no
  // `From<CratestackContext>`, and `CratestackContext::system` is
  // `#[serde(skip)]` — so the marker cannot arrive over a wire. The weaker
  // predicate would be satisfied by any authenticated caller if this table
  // were ever reached on behalf of a request.
  //
  // No `create` arm, though `CheckoutSessions::create` exists: that write did
  // NOT move, and an arm for a call site that does not exist is a standing
  // permission nobody asked for. What it would take is written down in
  // `vpay_db::checkout_sessions::create` and in docs/reference/vpay-db.md.
  @@allow("read", auth().isSystem())

  // GAP — `urls_match_ui_mode`, the CHECK that makes "a session's URLs always
  // match its mode" a property of the schema, is cross-column: five columns
  // in one predicate. Invisible here and invisible to the report, and
  // `a_hosted_session_without_urls_is_rejected_by_the_database` in
  // postgres_smoke.rs is what proves it fires.
}

// --- ledger ------------------------------------------------------------
// Mirrors backends/crates/vpay-ledger/src/lib.rs field-for-field. That
// crate's types and its balancing invariant ARE implemented and tested
// (docs/status.md: "🟡 Types and validate() done + 3 tests. Persistence not
// started") — unlike provider_requests/webhooks/jobs above, there is real,
// tested Rust code this half of the file mirrors, which is the line this
// rewrite draws between "design sketch of a tested type" and "invented
// shape for a concept nobody has written a struct for yet". No migration or
// SQLx query in this repo writes to either table below; this is the
// intended persistence shape, not evidence persistence exists.

model LedgerTransaction {
  id Cuid @id @default(dbgenerated())
  charge_id String
  charge Charge @relation(fields: [charge_id], references: [id])
  created_at DateTime @default(dbgenerated())

  entries LedgerEntry[] @relation(fields: [id], references: [transaction_id])

  // GAP — docs/flows/ledger.md invariant 1, "per transaction: SUM(debit) =
  // SUM(credit), per currency", cannot be a CHECK constraint under *any*
  // schema grammar, CrateStack included: SQL CHECK constraints evaluate one
  // row at a time, and this invariant is an aggregate over every
  // LedgerEntry row sharing a transaction_id. Expressing it at the database
  // layer needs a trigger (not something .cstack generates) or, as today,
  // application enforcement — exactly what
  // vpay_ledger::Transaction::validate() already does, tested by
  // a_capture_with_a_fee_balances / an_unbalanced_transaction_is_rejected.
}

model LedgerEntry {
  id Cuid @id @default(dbgenerated())
  transaction_id Cuid
  transaction LedgerTransaction @relation(fields: [transaction_id], references: [id])
  account AccountKind
  direction Direction
  amount Int @range(min: 0) @db_enforce
  currency_code String
  currency Currency @relation(fields: [currency_code], references: [code])

  // GAP — vpay_ledger::AccountKind has exactly 3 variants (MerchantPayable,
  // PayerClearing, PlatformFeeRevenue) with no per-merchant dimension, and
  // this table mirrors that Rust type exactly. But docs/flows/ledger.md
  // invariant 2 is "per merchant: balance(merchant_payable) = Σ captures −
  // Σ fees − Σ refunds" — a query this table cannot answer as modeled,
  // because nothing here says *which* merchant a merchant_payable posting
  // belongs to. That is a real gap in the Rust type this schema mirrors,
  // not something to paper over by adding a merchant_id column the Rust
  // side doesn't have.
}

// --- operations ----------------------------------------------------------

// The operator kill-switch (backends/migrations/0012_create-disabled-clients.sql).
//
// THE FIRST MODEL IN THIS FILE THAT IS COMPILED RATHER THAN SKETCHED. It is
// the one `vpay-db`'s private `mod schema` reads through CrateStack today —
// `DisabledClients::is_client_disabled` runs `find_unique(...).run(ctx)`
// against it — so unlike every other declaration here, getting a column
// wrong is a runtime decode failure rather than a design note. It was chosen
// to go first because it is the only vpay table whose every column type is
// already inside `cratestack-migrate`'s `map_scalar` (TEXT, TIMESTAMPTZ,
// TEXT), it carries no CHECK constraint, and it names no enum: the migration
// needed to model it is empty. See docs/reference/vpay-db.md § CrateStack.
//
// `@@allow("read", ...)` and NOTHING ELSE, deliberately. A model with no
// `@@allow` is deny-by-default and its generated reads return zero rows —
// the policy is compiled into the SQL `WHERE` clause, so the read succeeds
// and finds nothing rather than failing. That is why the parity test in
// `vpay-db/tests/repositories.rs` compares the CrateStack read against a
// direct sqlx read of the same row instead of merely asserting it does not
// error: deleting this line makes the kill-switch answer "not disabled" for
// every client, which is the failure this whole adoption most has to be
// unable to make silently.
//
// `auth().isSystem()` rather than `auth() != null`: `vpay-db` reaches this
// table as trusted in-process code, never on behalf of a request, and
// `SystemContext` is deliberately unreachable from a request-derived
// context (`cratestack-core`'s context/system.rs — there is no
// `From<CratestackContext>`), so the predicate a system read satisfies
// cannot be satisfied by anything an HTTP caller controls.
//
// The two WRITES moved to CrateStack on 2026-09-06, which is what the three
// extra `@@allow` arms below are for — this comment said "still raw sqlx"
// until then. `disable_client` is `.upsert(..).run(ctx)` and needs BOTH
// `create` and `update`: `cratestack-sqlx`'s `upsert_exec.rs` pre-flights
// the create policy on every call and `upsert_resolve.rs` gates the update
// branch separately, so a model with only one of the two fails whichever
// branch it did not name. `enable_client` is `.delete_many(..).run(ctx)`
// and needs `delete`.
//
// Four arms rather than one `@@allow("all", ...)`, deliberately — but NOT
// for the reason this comment gave until the review of 2026-09-06.
// `cratestack-macros`' `parse_policy_expression` treats `"all"` as matching
// every action, so one line would work, and it would grant exactly what
// these four grant and nothing more. This comment claimed `"all"` "would
// also grant `list` and `detail`"; it would not grant them *additionally*,
// because `@@allow("read", ...)` already does. `model/descriptor.rs:45-47`
// compiles the `read` arm into BOTH `&["list", "read"]` and
// `&["detail", "read"]`, which is asserted in
// `disabled_clients.rs::every_action_this_crate_calls_has_an_allow_arm`
// (`detail_allow_policies.len() == 1` with no `detail` arm declared here).
//
// The real and only reason for four lines is that each can be deleted on
// its own, and the four runtime effects are not alike:
//
//   create  -> LOUD  (`CratestackError::Forbidden` -> `PersistenceError::
//                     Denied` -> `Category::Internal`), on every call
//   update  -> LOUD, but only on the conflict branch — a first disable of
//              a given client succeeds and the second fails
//   delete  -> SILENT: `enable_client` goes through `delete_many`, whose
//              policy clause is part of the `WHERE`, so a missing arm
//              removes zero rows and returns `Ok`
//   read    -> SILENT, the same way, and the dangerous direction: every
//              revoked client is admitted again
//
// A wildcard would have made that asymmetry unmeasurable. All four
// mutations were run twice — by the change and again by its review —
// against a real Postgres; docs/status.md carries the dated row and
// docs/plans/exp16-notes/ the transcripts.
model DisabledClient {
  client_id String @id
  // `@default(now())`, not `@default(dbgenerated())`, and the difference is
  // measured rather than stylistic. `migrate baseline` introspects the live
  // column's `pg_get_expr(...)` as `ColumnDefault::Function("now()")`;
  // `@default(now())` converts to the same thing, so the two compare equal
  // and this table leaves the drift report entirely — 86 changes over 17
  // relations became 85 over 16. `@default(dbgenerated())` converts to
  // `ColumnDefault::DbGenerated`, which never equals a `Function`, so it
  // leaves one permanent `column disabled_at default value differs` line and
  // the total stays at 86. Both were run; see docs/plans/exp14-notes/opus.md.
  disabled_at DateTime @default(now())
  reason String?

  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())
  @@allow("delete", auth().isSystem())
}

// --- the outbox ----------------------------------------------------------

// `events` (migration 0018, extended by 0024 and 0029) and
// `webhook_deliveries` (0022) — docs/flows/webhooks.md's two-step outbox.
//
// These two models exist for ONE reason: they are the first vpay tables
// written through CrateStack inside a transaction **vpay opened and vpay
// closes**. `UnitOfWork::transaction` hands the closure a
// `PendingTransaction`; `PendingTransaction::tx()` hands that transaction to
// `run_in_tx`. Everything `config_reconcile` proved about `run_in_tx` it
// proved on a transaction CrateStack could not tell apart from its own,
// because `reconcile` owns that one too. Here the transaction is the
// settlement's / the fan-out's, and the rollback that has to take a
// CrateStack write with it is vpay's.
//
// WHAT MOVED, AND WHAT DID NOT — the honest half.
//
//   TxRepositories::create_in_tx        -> WebhookDelivery
//                                         .upsert(..).do_nothing()  MOVED
//   TxRepositories::mark_fanned_out_in_tx -> Event .update_many(..) MOVED
//   TxRepositories::insert_in_tx        -> Event .create(..)    NOT MOVED
//
// `insert_in_tx` is blocked, and the block is measured rather than argued:
// `events.data` is `JSONB NOT NULL` with no `DEFAULT`. A model that does not
// declare `data` generates
// `INSERT INTO events (id, merchant_id, livemode, type, object_id) ...`,
// which Postgres refuses with `23502 null value in column "data" violates
// not-null constraint` — pinned by
// `the_events_insert_cannot_move_until_a_json_column_can_be_modelled` in
// `backends/crates/vpay-db/src/events.rs`. Declaring `data Json` is the only
// other option at 0.12.0 and it is NOT taken here; see the GAP note at the
// end of `model Event` for the two measured reasons.
//
// WHY NO `@db_enforce` ANYWHERE BELOW, unlike `model Currency`.
//
// `@db_enforce` promotes a validator to a CHECK named
// `naming.rs::check_name` -> `<table>_<column>_<validator>_check`. The live
// CHECKs are hand-named (`id_length`, `endpoint_id_length`, `url_length`,
// `excerpt_length`), so promoting them would make the diff emit a
// drop-and-add pair on two different names — TWO drift lines where not
// declaring them at all is ONE, and `ir/checks.rs` guarantees the kinds can
// never match anyway because introspection reports every validator-derived
// CHECK as `CheckKind::Raw`. Measured 2026-09-06, and it is exp17's finding
// (docs/plans/exp17-notes/opus.md §1a) applied in the only direction that is
// available without a rename migration, which this change deliberately does
// not add.
//
// The validators are still declared WITHOUT `@db_enforce`, and that is not a
// no-op: `cratestack-macros`' `inputs.rs::validate_impl_tokens` generates
// `input.validate()` from the validator list regardless of `@db_enforce`, and
// `run_upsert_do_nothing_in_tx` calls it before any SQL runs. So the bound is
// enforced twice — once in-process, once by the CHECK that was already there
// — and the in-process half fails *before* the transaction has written
// anything. Only bounds the migrations actually declare appear below; there
// is deliberately no validator on `WebhookDelivery.event_id`, because
// migration 0022 declares no length CHECK on that column and inventing one
// here would be this file claiming a constraint the database does not have.

model Event {
  id String @id @length(min: 1, max: 64)
  // `GENERATED ALWAYS AS IDENTITY` (migration 0018), and an identity column
  // carries no `pg_attrdef` default — `information_schema` reports
  // `column_default` NULL and `is_identity = YES`. Introspection reads only
  // the former, so this line costs exactly one permanent
  // `column `seq` default value differs` drift line, measured 2026-09-06.
  // Kept anyway, and the trade is worth writing down: dropping the
  // `@default(...)` closes that line and makes `seq` a REQUIRED field of
  // `CreateEventInput` — an explicit value for a `GENERATED ALWAYS` column,
  // which Postgres refuses outright. One honest drift line beats a create
  // input that cannot be filled in correctly.
  seq Int @default(dbgenerated())
  merchant_id String @length(min: 1, max: 128)
  livemode Boolean
  // The closed event vocabulary stays a hand-named database CHECK
  // (`type_is_a_documented_event`, migrations 0018 and 0029), and this field
  // carries no validator at all, because 0.12.0 has none that expresses
  // "one of these eight strings" on a `String` column. The two candidates
  // were both measured and both rejected:
  //
  //   - a `.cstack` `enum EventType` with the variants. `providers.flow`
  //     shows this CAN match (exp17: Postgres deparses `IN (...)` into the
  //     shape `check_pattern.rs::reconstruct_enum` reads back) — but only
  //     under the generated name `events_type_enum_check`. The live
  //     constraint is `type_is_a_documented_event`, and `diff/checks.rs`
  //     matches by name first, so the report would grow a drop-and-add pair
  //     rather than converge. Renaming it needs migration 0033, which this
  //     change is scoped not to add.
  //   - `@db_enforce` on some length validator: expresses nothing about the
  //     vocabulary.
  //
  // THE HAZARD, recorded because it is the F4 one and it is real: because
  // the schema does not declare this CHECK, a generated `cratestack migrate
  // diff` would emit DDL that DROPS `type_is_a_documented_event` as
  // undeclared. Nothing in this repository runs `migrate diff` — the
  // migrations are hand-written and `_sqlx_migrations` is the sole runner
  // (docs/reference/vpay-db.md) — so the hazard is latent, not live. It
  // becomes live the day anyone generates a migration from this file, and
  // the same is true of every other `[safe] CHECK ... exists in the live
  // database but is not declared in the schema` line in the drift report.
  type String
  object_id String @length(min: 1, max: 64)
  // `fanout_state_is_known` (0018, widened by 0024 to a third value) is the
  // same multi-value single-column case as `type` above, and left hand-named
  // for the same reason. `@default('pending')` — single quotes — because
  // `convert/fields.rs::field_default` classifies an unquoted, non-`()`
  // argument as a bare `Literal` and the live default deparses to
  // `'pending'::text`; measured, the double-quoted spelling costs one
  // `default value differs` line and this one costs none.
  fanout_state String @default('pending')
  created_at DateTime @default(now())

  // `update` and nothing else. `mark_fanned_out_in_tx` is an
  // `update_many(...).where_(id).where_(fanout_state = 'pending')`, and
  // `update_many_exec.rs` compiles `update_allow_policies` into the
  // statement's own `WHERE` — so a missing arm is SILENT in the error
  // channel and catastrophic in behaviour: the compare-and-swap matches zero
  // rows, returns `false`, and `fan_out_one` abandons EVERY transaction, so
  // no merchant is ever delivered anything while every log line says the
  // drain ran. Because the failure is silent rather than raised, the tests
  // that catch it catch it by its effect:
  // `a_committed_fan_out_keeps_both_cratestack_writes` is the container one,
  // and the no-container `every_action_this_module_calls_has_an_allow_arm`
  // catches it in milliseconds.
  //
  // No `read` arm: nothing reads `events` through CrateStack — every read in
  // `vpay_db::events` is still `sqlx`, because `EventRow` carries `data` and
  // paging is `WHERE seq > $1 ORDER BY seq LIMIT`, neither of which this
  // model can express (see the GAP note). No `create` arm, for the same rule
  // `model Provider` states: an arm no call site uses is a permission
  // nothing can measure. Grant them in the commit that moves the write.
  @@allow("update", auth().isSystem())

  // GAP — `data JSONB NOT NULL` is not declared, and that is what keeps
  // `insert_in_tx` on raw sqlx.
  //
  // 0.12.0 HAS a `Json` scalar (`emit/postgres/columns.rs`: `"Json" =>
  // "JSONB"`, `shared/types.rs`: `Json` -> `::cratestack::Json<::cratestack::Value>`),
  // so "cratestack cannot model a JSONB column" would be false. Two measured
  // costs are why it is still not declared here:
  //
  //   1. `introspect/postgres/types.rs::map_scalar` does NOT map `jsonb`
  //      back to any `.cstack` scalar — `jsonb` is on the deliberate
  //      unmapped list beside `numeric` and the narrow ints. So an
  //      undeclared `jsonb` column is INVISIBLE to the comparison in both
  //      directions (measured: declaring these two models moved
  //      `EXPECTED_UNMAPPABLE_COLUMNS` not at all, and produced no
  //      `column `data` exists in the live database` line), whereas
  //      declaring `data Json` makes the live column stay invisible while
  //      the declared one becomes a `[blocking] column `data` is declared in
  //      the schema but does not exist in the live database` line — exactly
  //      what `currencies.exponent` did before migration 0032.
  //   2. The one that actually decides it. `cratestack::Value` is not
  //      `serde_json::Value`: `Value::from_plain_json` maps a JSON number
  //      through `Number::as_i64()` and falls back to
  //      `as_f64().unwrap_or_default()`, so a `u64` above `i64::MAX`
  //      anywhere in the payload comes back as an `f64`. `events.data` is
  //      the wire object that is stored, SIGNED and delivered to a merchant
  //      (docs/flows/webhooks.md), and it embeds merchant-authored
  //      `metadata` — arbitrary JSON vpay does not choose. Routing that
  //      through a lossy number conversion to save one raw statement is not
  //      a trade this table gets to make.
  //
  // So the insert stays one hand-written `sqlx` statement, in the SAME
  // transaction as everything above — honest, ugly, reversible. It is
  // reversible the day `map_scalar` learns `jsonb` AND `Value` round-trips
  // an arbitrary `serde_json::Value`; both halves are needed.
  //
  // WHICH TEST NOTICES WHICH HALF — corrected 2026-09-06 by the review,
  // because this comment used to say
  // `the_events_insert_cannot_move_until_a_json_column_can_be_modelled`
  // "fails when the first one lands so nobody has to remember", and it
  // cannot. That test calls `preview_sql`, which renders from the macro
  // expansion of THIS FILE and nothing else, so its output is a function of
  // the declaration below being absent. `map_scalar` lives only in
  // `cratestack-migrate` — introspection, which `cratestack-pg` takes as a
  // dev-dependency — so it is not in `vpay-db`'s compiled graph at all and
  // an upstream fix to it cannot change what that test sees.
  //
  //   * `map_scalar` learning `jsonb` is noticed by
  //     `the_cstack_schema_drifts_from_the_migrations_by_a_measured_amount`,
  //     which pins `EXPECTED_UNMAPPABLE_COLUMNS = 17`. `events.data` would
  //     leave that list and the count would move.
  //   * `Value` growing a lossless round-trip is noticed by nothing here,
  //     and cannot be — it is a property of a crate this file does not
  //     compile against. It has to be checked when the first bullet fires.
  //   * The two pins below are what notice somebody DECLARING `data Json`,
  //     which is the mistake they are actually good for: they go red before
  //     a lossy conversion can reach a signed payload.
  //
  // GAP — `fanout_attempts INT` (migration 0024) is not declared either, and
  // this one costs nothing. `Int` always emits `int8`; `map_scalar` refuses
  // to read `int4` back as `Int` ("an `int4` column silently mapped to `Int`
  // would make a live table that actually differs from the schema look
  // identical to it"), so the live column is excluded from the comparison
  // and declaring it would add a `[blocking] ... does not exist in the live
  // database` line while changing nothing about the database. Measured
  // 2026-09-06. `EventRow` does not carry it either, and
  // `Events::record_fanout_failure` — which does — is deliberately a
  // statement on the POOL, not in any transaction, because it counts the
  // failure of a transaction that has rolled back.
  //
  // GAP — `Events::pending_page` / `list_page` / `get_by_id` /
  // `get_unscoped` stay raw sqlx. `list_page`'s cursor is a correlated
  // sub-select (`seq < (SELECT seq FROM events WHERE id = $2 AND merchant_id
  // = $1)`) that no delegate expresses, and every one of the four projects
  // `data`. Neither is a defect in this file; both are `docs/reference/vpay-db.md`
  // § CrateStack's "what stays raw SQL" list.
}

model WebhookDelivery {
  // THE LIVE COLUMN HAS `DEFAULT gen_random_uuid()` AND THIS LINE
  // DELIBERATELY DOES NOT DECLARE IT. That costs exactly one
  // `[safe] column `id` default value differs` drift line (measured
  // 2026-09-06: 100 -> 101), and it is the price of `create_in_tx` being
  // expressible at all.
  //
  // `cratestack-macros`' `inputs.rs::generate_upsert_input_struct` returns
  // an EMPTY token stream when `is_generated_on_create(primary_key)` — its
  // own comment says "Server-generated PKs get no upsert impl; calling
  // `.upsert(...)` is a compile error" — and `is_generated_on_create` is
  // `has_default(field)`. With `@default(gen_random_uuid())` here,
  // `CreateWebhookDeliveryInput` carries no `id` field, no
  // `UpsertModelInput` impl exists, and
  // `webhook_delivery().upsert(..).do_nothing()` does not compile. Measured:
  // `error[E0599]: no method named `upsert` found`.
  //
  // The fallback — a plain `.create(..)` — is NOT equivalent and is why this
  // is worth a paragraph. `create_in_tx` must answer `Ok(None)` for a
  // (event_id, endpoint_id) pair that already exists, because the fan-out
  // drain is at-least-once and a re-run must enqueue no second
  // `deliver_webhook` job. A bare `INSERT` raises `23505` against
  // `webhook_deliveries_event_endpoint` instead — and a failed statement
  // ABORTS the enclosing Postgres transaction, so the error cannot be caught
  // and turned back into `None` without a `SAVEPOINT` this layer does not
  // have. `ON CONFLICT DO NOTHING` is load-bearing, not stylistic.
  //
  // So the id is minted by `vpay-db` (`Uuid::new_v4()`) rather than by
  // Postgres. Both are v4 UUIDs, nothing references the column, and the
  // database default stays exactly where it is for any writer that omits the
  // column — it is now vestigial rather than wrong. Dropping it in a
  // migration would close the drift line and is deliberately NOT done here:
  // it is a DDL change bought by a code generator's input-shaping rule,
  // which is the trade `model Provider`'s GAP note reserves for the
  // maintainer. The difference worth noting is that unlike `Provider`, this
  // one needed no DDL to unblock.
  id Uuid @id
  // No validator: migration 0022 declares no length CHECK on this column.
  // It is a foreign key into `events (id)`, and that FK is not declared here
  // either — `@relation` needs a `WebhookDelivery[]` back-reference on
  // `model Event`, which would make `Event` name a model whose only purpose
  // is a write path `Event` is not part of. The FK is real in the database
  // and the dangling-delivery half of
  // `migration_0022_reopens_the_job_kinds_and_closes_the_delivery_states`
  // proves it fires; introspection does not report a live-only foreign key,
  // so leaving it undeclared costs zero drift (measured).
  event_id String
  endpoint_id String @length(min: 1, max: 64)
  url String @length(min: 1, max: 2048)
  state String @default('pending')
  // `excerpt_length` is `response_excerpt IS NULL OR char_length(...) <=
  // 2000` — a nullable bound with no minimum, which is exactly `@length(max:
  // ...)` on an optional field.
  response_excerpt String? @length(max: 2000)
  payload_sha256 String?
  created_at DateTime @default(now())
  sent_at DateTime?
  responded_at DateTime?
  next_attempt_at DateTime?

  // BOTH arms are required by ONE call, and that is not obvious enough to
  // leave to a reader of `upsert_do_nothing_exec.rs`.
  // `create_in_tx` is `.upsert(input).do_nothing().on_conflict(columns)`:
  //
  //   create -> LOUD, unconditionally. `run_upsert_do_nothing_in_tx` calls
  //             `evaluate_create_policies` before any SQL runs, so a missing
  //             arm fails every fan-out with `Forbidden` ->
  //             `PersistenceError::Denied` -> `Category::Internal`.
  //   update -> LOUD, but ONLY on the already-exists branch.
  //             `upsert_do_nothing_authorize.rs` re-checks
  //             `row_passes_update_policy` on the `Existing` path, whose own
  //             doc says why: `.do_nothing()` hands the caller that row's
  //             contents, so create authorisation alone must not be a probe
  //             for a row's existence. A missing arm therefore lets the
  //             FIRST fan-out of an event succeed and fails only a re-run —
  //             the crash-recovery path, i.e. the one nobody exercises until
  //             production does.
  //
  // AND THAT RE-CHECK RUNS ON A POOL CONNECTION, NOT ON THE CALLER'S
  // TRANSACTION, which is worth knowing here because it narrows
  // `create_in_tx`'s contract. `row_passes_update_policy` takes
  // `runtime.pool()` and issues its own `SELECT 1 FROM webhook_deliveries
  // WHERE ...`, so a row the caller inserted moments ago in its own
  // still-open transaction is found by the `Existing` pre-probe (which does
  // read through `tx`) and then invisible to the authorisation read — which
  // reports that as a denial. Measured 2026-09-06: a second `create_in_tx`
  // for one pair inside ONE transaction answers `Denied`, where the raw
  // `INSERT ... ON CONFLICT DO NOTHING` it replaced answered `None`.
  // Unreachable in vpay (a duplicate endpoint `id` is refused at boot and
  // deduped by `EndpointRegistry`), pinned by
  // `a_repeat_creation_inside_one_transaction_is_refused_rather_than_reported_missing`,
  // and reported upstream — docs/plans/exp18-notes/opus-review.md F2 and §4.
  //
  // No `read`, no `delete`: nothing reads or deletes a delivery through
  // CrateStack. `WebhookDeliveries::{get,pending_due,for_event,
  // record_success,record_attempt}` are all still sqlx, because `DeliveryRow`
  // carries `attempt` and `status_code` and both are `int4` (see the GAP
  // note below).
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())

  // GAP — `attempt INT NOT NULL DEFAULT 0` and `status_code INT` are not
  // declared, for `Event.fanout_attempts`' reason and with the same measured
  // answer: `int4` is on `map_scalar`'s deliberate unmapped list, so both are
  // already excluded from the comparison and declaring them as `Int` would
  // add two `[blocking] ... is declared in the schema but does not exist in
  // the live database` lines while changing nothing in the database.
  //
  // The cost is real and worth naming: `CreateWebhookDeliveryInput` cannot
  // carry them — which is harmless HERE, because `create_in_tx` sets neither
  // (both take their column default), and `RETURNING id` is all the caller
  // reads. It is what keeps `record_attempt` and `record_success` on raw
  // sqlx, since both write `attempt` / `status_code`. Widening the columns to
  // `BIGINT` the way migration 0032 widened `currencies.exponent` would close
  // this, and it is NOT done here: 0032 was measured to break the previous
  // release's binary at boot (docs/plans/exp17-notes/opus-review.md finding
  // 3), and a rolling-deploy cost like that belongs to the maintainer, not
  // to a persistence-layer swap.
}

// --- customers -----------------------------------------------------------

// `customers` (migration 0034) — the FIRST vpay table born with a model
// rather than acquiring one afterwards, and the only place in this file
// where the ordering ran that way.
//
// WHAT THAT BOUGHT, MEASURED RATHER THAN CLAIMED
//
// Migration 0033 exists because `providers` was modelled *after* it was
// built: `cratestack-macros` drops every `@default(...)` field from
// `Create{Model}Input` and from `upsert_update_columns`
// (`model/inputs.rs:20-26`, `model/descriptor/columns.rs:92-101`), so the
// five capability booleans could not be written through the generated input
// until their column DEFAULTs came off. 0034 pays that cost up front: no
// column CrateStack writes carries a `DEFAULT`, and the two that do —
// `created_at` and `updated_at` — are declared `@default(now())` here for
// `DisabledClient.disabled_at`'s measured reason (introspection reads the
// live default as `ColumnDefault::Function("now()")`, which `@default(now())`
// converts to exactly and `@default(dbgenerated())` never equals).
//
// WHAT ACTUALLY RUNS THROUGH THIS MODEL, AND WHAT DELIBERATELY DOES NOT
//
//   Customers::touch_last_used  -> update_many(..).set(..)   THROUGH CRATESTACK
//   Customers::delete           -> delete_many(..)           THROUGH CRATESTACK
//   Customers::{create, update, get_for_merchant, list_page,
//               idle_since, delete_idle}                     RAW sqlx
//
// The split is decided by ONE column, `metadata JSONB NOT NULL`, and by the
// two measurements in the GAP note at the end of this model. Every operation
// that has to read or write `metadata` stays a hand-written statement;
// the two that do not are the two that go through the generated data layer.
//
// That is not a consolation prize. `touch_last_used` is the write the
// twelve-month retention sweep reads: get it wrong and vpay deletes a
// merchant's live customer. `delete` is the hard delete of personal data.
// They are the two operations on this table where being wrong costs
// something irreversible, and they are the two the policy engine now guards.
//
// WHY `read` IS GRANTED WHEN NOTHING CALLS `find_unique`
//
// It is NOT granted. There is no `@@allow("read", ...)` below, and that is
// the rule `model Provider` states and `model Event` follows: an arm no call
// site uses is a permission nothing can measure. `Customers::get_for_merchant`
// is raw sqlx (it must render `metadata`), so a `read` arm here would be
// dead grant. Add it in the commit that moves a read.
model Customer {
  id String @id @length(min: 1, max: 64)
  // `GENERATED ALWAYS AS IDENTITY` (migration 0034), and `model Event.seq`'s
  // trade applies unchanged: an identity column carries no `pg_attrdef`
  // default, introspection reads only that, so this line costs exactly one
  // permanent `column `seq` default value differs` drift line. Dropping the
  // `@default(...)` would close that line and make `seq` a REQUIRED field of
  // `CreateCustomerInput` — an explicit value for a `GENERATED ALWAYS`
  // column, which Postgres refuses outright.
  seq Int @default(dbgenerated())
  merchant_id String @length(min: 1, max: 128)
  livemode Boolean
  // The three identifiers. `@sensitive` on all three, which is what
  // `cratestack-macros`' `is_sensitive_field` reads to redact a value from
  // the audit log — nothing in vpay audits today (`@@audit` is not declared
  // and `ensure_audit_table` is therefore never reached), so this is a
  // property of the model for the day one does, not a live behaviour. It is
  // declared now because the alternative is deciding retroactively which of
  // a merchant's payer identifiers were safe to have written to a log.
  //
  // The bounds mirror migration 0034's `name_length` / `email_length` CHECKs
  // and carry NO `@db_enforce`, for `model Event`'s measured reason: the
  // live CHECKs are hand-named, `@db_enforce` would generate
  // `customers_name_length_check`, `diff/checks.rs` matches by name first, so
  // promoting them would emit a drop-and-add PAIR where declaring them
  // without `@db_enforce` emits nothing. The validators are not inert
  // either: `inputs.rs::validate_impl_tokens` generates `input.validate()`
  // from the validator list regardless, and every write path calls it before
  // any SQL runs.
  //
  // `phone` carries no `@length` at all, deliberately, because migration
  // 0034's `phone_is_a_canonical_msisdn` is a *regex* and not a length bound:
  // a `@length(min: 8, max: 15)` here would be a second, weaker copy of it
  // that accepts `not-a-phone!` and would read as though the shape were
  // checked in-process when it is not. The shape is
  // `vpay_api::v1::customers`' job on the way in and the CHECK's on the way
  // down; this file claims neither.
  name String? @sensitive
  email String? @sensitive
  phone String? @sensitive
  // The twelve-month sweep's whole input (the maintainer's decision of
  // 2026-09-05). NO `@default(...)`: `touch_last_used` is the only writer
  // that goes through this model, and `Update{Model}Input`'s field for a
  // required column is `Option<OffsetDateTime>` — outer `None` meaning "this
  // patch does not touch the column", which is exactly what every other
  // field of that input is left at.
  last_used_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  // The live index is `customers_merchant_seq_idx ON (merchant_id, seq DESC)`
  // — two columns and a direction, neither of which this grammar's
  // `@@index([...])` can express (0.11.1 emits an unordered index over the
  // listed columns). Declaring `@@index([merchant_id])` would therefore be a
  // claim about an index the database does not have, in a file whose whole
  // discipline is not to make those: it would add a `[blocking] index ... is
  // declared in the schema but does not exist in the live database` line and
  // a `[safe] index customers_merchant_seq_idx exists in the live database
  // but is not declared` line beside it — TWO drift lines to describe one
  // index, neither of them true. The three indexes migration 0034 creates
  // are named in that migration and nowhere else.

  // `update` and `delete`, and NOTHING else, because those are the two
  // actions this crate calls. Each can be deleted on its own and the two
  // runtime effects are not alike — the asymmetry `model DisabledClient`
  // records, applied here:
  //
  //   update -> SILENT. `touch_last_used` is `update_many(..)`, whose policy
  //             is compiled into the statement's own `WHERE`
  //             (`update_many_exec.rs`), so a missing arm matches zero rows
  //             and returns `BatchSummary { ok: 0 }`. Nothing errors. Every
  //             customer's `last_used_at` then freezes at creation, and the
  //             retention sweep deletes live customers twelve months later —
  //             a merchant's personal-data records destroyed with every log
  //             line saying the sweep ran normally. This is the single most
  //             dangerous line in this file.
  //   delete -> SILENT the same way (`delete_many`'s policy is also part of
  //             the `WHERE`), and dangerous in the opposite direction:
  //             `DELETE /v1/customers/{id}` answers `{deleted: true}` while
  //             the row stays, so a merchant is told personal data was
  //             erased and it was not.
  //
  // Because both failures are silent in the error channel, the tests that
  // catch them catch them by effect and by declaration:
  // `every_action_this_module_calls_has_an_allow_arm` in
  // `vpay-db/src/customers.rs` fails in milliseconds with no container, and
  // the container cases in `vpay-db/tests/repositories.rs` fail on the row.
  @@allow("update", auth().isSystem())
  @@allow("delete", auth().isSystem())

  // GAP — `metadata JSONB NOT NULL` is not declared, and that is what keeps
  // create, update and every read of this table on raw sqlx.
  //
  // Exactly `model Event.data`'s situation and the same two measured costs,
  // restated because the consequence here is different (there it blocked one
  // insert; here it blocks five of seven repository methods):
  //
  //   1. `introspect/postgres/types.rs::map_scalar` does not map `jsonb` back
  //      to any `.cstack` scalar. An UNdeclared `jsonb` column is invisible
  //      to the comparison in both directions; a DECLARED `metadata Json`
  //      would leave the live column invisible while making the declared one
  //      a `[blocking] column `metadata` is declared in the schema but does
  //      not exist in the live database` line.
  //   2. The one that decides it. `cratestack::Value` is not
  //      `serde_json::Value`: `Value::from_plain_json`
  //      (`cratestack-core/src/value.rs:99-102`) maps a JSON number through
  //      `Number::as_i64()` and falls back to `as_f64().unwrap_or_default()`,
  //      so any number outside `i64` is silently demoted to a float.
  //      `customers.metadata` is merchant-authored and is echoed back
  //      verbatim on every read and inside every `customer.*` webhook body.
  //      vpay's own form decoder only ever produces strings today, which
  //      makes the demotion unreachable *today* — and that is an argument
  //      for not relying on it: the column would silently start corrupting
  //      values the day anything wrote a number into it.
  //
  // The migration is what makes this a tripwire rather than a note.
  // `metadata` is `NOT NULL` with **no DEFAULT**, so a generated INSERT that
  // omitted it fails `23502` at once instead of writing `{}` over a
  // merchant's data. `a_generated_customer_insert_cannot_carry_metadata` in
  // `vpay-db/src/customers.rs` pins the rendered statement.
}

// --- intentionally not modeled ------------------------------------------
//
// The following are named in docs/flows/*.md and marked ⛔ "not started" in
// docs/status.md, with zero corresponding Rust struct anywhere in
// backends/crates/*/src (checked by grep for each name below). Modeling
// their column shapes from doc prose alone would be inventing a plausible
// schema for code that does not exist — the exact failure mode this file
// was rewritten to stop doing:
//
//   - webhook ENDPOINTS. Not a table and never will be one: endpoints are
//     configuration (`merchant_clients[].webhooks[]`, ADR-0003), which is
//     why `webhook_deliveries.endpoint_id` above references nothing. The
//     event/outbox pair itself is modelled now — see `model Event` and
//     `model WebhookDelivery` above.
//   - the job queue and its dedupe_key (docs/flows/reconciler.md).
//     Deliberately NOT modelled, and the reason is specific rather than
//     "nobody got to it": `Jobs::claim` is `FOR UPDATE SKIP LOCKED`, and
//     `FindMany::for_update()` (query/read/find_many.rs) emits a bare
//     `FOR UPDATE` with no `SKIP LOCKED`. A lease mechanism that silently
//     lost `SKIP LOCKED` would turn every worker's claim into a queue
//     behind every other worker's claim. `jobs.payload` is `JSONB` besides,
//     and `jobs.attempts` is `int4`.
//   - idempotency keys (docs/status.md: ⛔, no design doc field list either)
//   - Merchant (referenced only as a bare merchant_id string everywhere
//     above — see the GAP note on PaymentIntent.merchant_id)
//
// Add each once its crate has a real, tested type to mirror — the same bar
// this file just applied to the ledger models above.

// --- staff sign-in (ADR-0017) --------------------------------------------

// `staff_members`, `staff_sessions` and `oauth_authorization_codes` (migration 0035)
// — the three tables that let a human reach `/dash/v1`.
//
// THESE THREE ARE THE FIRST MODELS IN THIS FILE WHOSE EVERY REPOSITORY
// METHOD RUNS THROUGH CRATESTACK. `DisabledClient` got there for three
// methods and `Customer` for two of seven; here it is all of them, and that
// is a property of migration 0035 rather than of ambition: the tables were
// shaped so it would be true. No `jsonb` column (which is what keeps five of
// `Customer`'s seven on raw sqlx), no `bytea`, no native enum, no `DEFAULT`
// on any column a writer names, and no `seq` cursor — so every `Create…Input`
// below can carry every column the writer has to set.
//
// The cost of that is stated where it is paid: the encrypted TOTP secret is
// base64url `TEXT` rather than `BYTEA` (see `Staff.totp_secret`), and the
// code store's single-use guard is a `Boolean` rather than `consumed_at IS
// NULL` (see `OauthAuthorizationCode.consumed`), both because of what 0.11.1
// can express.
//
// NO `@db_enforce` ANYWHERE BELOW, for `model Event`'s measured reason: the
// live CHECKs are hand-named, `@db_enforce` would generate
// `<table>_<column>_<validator>_check`, `diff/checks.rs` matches by name
// first, so promoting them emits a drop-and-add PAIR where declaring them
// without it emits nothing. The validators are still not inert —
// `inputs.rs::validate_impl_tokens` generates `input.validate()` from the
// validator list regardless, and every generated write path calls it before
// any SQL runs.
//
// NO ENUM TYPE for `Staff.status` or `StaffSession.state`, although both are
// closed vocabularies with a live CHECK. A `.cstack` enum would give the
// column type `Enum("StaffStatus")` against a live `Scalar("String")` — one
// permanent `column type differs` drift line per column, which is what every
// one of the six remaining native-enum columns already costs
// (docs/reference/vpay-db.md, "The enum conversion no report can see") — and
// the CHECK's *kind* could not converge either, because introspection reports
// a hand-written `IN (...)` on a TEXT column as `CheckKind::Raw` and only
// reconstructs `CheckKind::Enum` from `pg_enum`. So: `String` here, a real
// Rust enum in `vpay_db::staff`, and the CHECK in the migration. The
// vocabulary is closed by the database and mirrored by the parse, exactly as
// `events.type` and `jobs.kind` are.

// `StaffMember` and not `Staff`, and the name decides the TABLE name: 0.11.1
// derives it with `pluralize(to_snake_case(model))` and has no `@@map`, so
// `model StaffMember` would read and write `staffs`. Migration 0035's header records
// the measurement. The Rust trait is still `vpay_db::Staff`.
model StaffMember {
  id String @id @length(min: 1, max: 64)
  merchant_id String @length(min: 1, max: 128)
  email String @length(min: 3, max: 512)
  display_name String @length(min: 1, max: 256)
  // `@sensitive` is what `cratestack-macros`' `is_sensitive_field` reads to
  // redact a value from the audit log. Nothing in vpay audits today (`@@audit`
  // is not declared, so `ensure_audit_table` is never reached) — `model
  // Customer`'s three identifiers carry it for the same forward-looking
  // reason. These two are stronger cases than those: an argon2id digest is an
  // offline cracking target and the sealed TOTP secret is a second factor.
  password_hash String @sensitive
  password_change_required Boolean
  // The AES-256-GCM sealed RFC 6238 secret, base64url, nonce-prefixed.
  //
  // `String?` AND NOT `Bytes`, and the reason is the data layer rather than a
  // preference. `cratestack-migrate`'s `map_scalar` does not map `bytea`
  // (docs/reference/vpay-db.md, "Six Postgres types are mapped, and vpay uses
  // more than six"), so a `BYTEA` column would be excluded from the drift
  // comparison outright and — the half that decides it — could not be named
  // in `CreateStaffInput` at all, which would put enrolment back on raw sqlx
  // and defeat the point of shaping 0035 the way it is shaped.
  totp_secret String? @sensitive
  totp_enrolled_at DateTime?
  // The RFC 6238 time step of the last accepted code. `Int` is `int8`, which
  // is why migration 0035 declares `BIGINT` and not `INT`: `int4` is one of
  // the six unmapped types and `currencies.exponent` had to be widened by
  // migration 0032 for exactly this reason. A table born with a model does
  // not repeat that.
  //
  // NOT `Int?`. `NULL < step` is NULL in SQL, so a nullable column would make
  // the compare-and-swap refuse every staff member's FIRST code forever —
  // migration 0035 seeds it to 0 and declares it `NOT NULL` for that reason.
  last_totp_step Int
  status String
  // NO `@default(now())`, unlike `Customer.created_at`, and this is the one
  // difference between these models and 0034's that a reader should notice.
  // `cratestack-macros` drops every `@default(...)` field from
  // `Create{Model}Input` (`model/inputs.rs:20-26`), so a defaulted
  // `created_at` is a column the CLI's `staff add` could not set. `Customer`
  // can afford the default because its create is hand-written sqlx; these
  // cannot, so migration 0035 declares no `DEFAULT` and the writer supplies
  // both stamps. That also means the two sides agree and the columns cost no
  // drift — a `DEFAULT` costs drift only when the two sides disagree
  // (migration 0033's measurement).
  created_at DateTime
  updated_at DateTime
  last_sign_in_at DateTime?

  // Four arms, one per action `vpay_db::staff` calls, each separately
  // droppable — `model DisabledClient`'s reason for four lines rather than
  // one `@@allow("all", …)`. The runtime effects are the asymmetry that
  // module's table measured, and here they are:
  //
  //   read   -> SILENT, and this is the dangerous one in the *safe*
  //             direction: `find_unique` compiles the policy into the
  //             `WHERE`, so a missing arm makes every sign-in answer "no such
  //             account". Loud in practice (nobody can log in) and harmless.
  //   create -> LOUD. `upsert`/`create` evaluate `create_allow_policies` in
  //             Rust before any SQL, so `staff add` fails with a `Forbidden`
  //             naming the model.
  //   update -> SILENT, and this is the dangerous one in the DANGEROUS
  //             direction. `update_many`'s policy is part of the statement's
  //             `WHERE`, so a missing arm makes `record_totp_step` match zero
  //             rows and return `ok: 0` — and `record_totp_step` is the
  //             REPLAY GUARD. A TOTP code would become reusable for its whole
  //             +/-1-step window with every log line saying the sign-in
  //             succeeded normally. `every_action_this_module_calls_has_an_allow_arm`
  //             in `vpay-db/src/staff.rs` is what makes that red in
  //             milliseconds with no container.
  //   delete -> SILENT. Nothing in vpay deletes a staff row today; the arm is
  //             here because `staff_sessions`' and
  //             `oauth_authorization_codes`' cascades name this table, and an
  //             operator deleting an account through a future surface must
  //             not be told it worked while the row stayed.
  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())
  @@allow("delete", auth().isSystem())
}

model StaffSession {
  // The SHA-256 of the opaque session token, lower-case hex — never the
  // token. 64 characters exactly, which migration 0035 states as an equality
  // CHECK and this states as a bound, for the reason above: no
  // `@db_enforce`, so the two never have to converge on a name, and the
  // generated `input.validate()` still refuses a writer that got the width
  // wrong before any SQL runs.
  id String @id @length(min: 64, max: 64)
  staff_id String @length(min: 1, max: 64)
  state String
  created_at DateTime
  expires_at DateTime
  last_seen_at DateTime
  // The `/dash/v1` access token, once the exchange has minted one.
  // `@sensitive` for `Staff.password_hash`'s reason and more urgently: this
  // is a live bearer credential for the length of its TTL.
  access_token String? @sensitive

  // No `@relation` to `Staff`, although `staff_sessions.staff_id` is a real
  // foreign key. 0.11.1's `@relation` needs both ends declared and side-loads
  // rows this crate never wants side-loaded: every read here is by primary
  // key and the staff row is fetched separately, deliberately, so that a
  // disabled account is re-checked on the session read rather than trusted
  // from a join taken when the session was created.
  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())
  @@allow("delete", auth().isSystem())
}

model OauthAuthorizationCode {
  code_hash String @id @length(min: 64, max: 64)
  client_id String @length(min: 1, max: 256)
  staff_id String @length(min: 1, max: 64)
  session_id String @length(min: 64, max: 64)
  merchant_id String @length(min: 1, max: 128)
  scope String
  code_challenge String @length(min: 1, max: 256)
  code_challenge_method String
  redirect_uri String @length(min: 1, max: 2048)
  nonce String?
  created_at DateTime
  expires_at DateTime
  // THE SINGLE-USE GUARD, and one nullable column is all of it. The consume
  // is a compare-and-swap —
  // `update_many().where_(code_hash).where_(consumed_at().is_null())
  // .set(consumed_at)` — so `BatchSummary::ok == 1` is the atomic answer to
  // "did I win the race", which is the property
  // `AuthorizationCodeStore::consume_code`'s own doc calls "the single most
  // important correctness property in this crate".
  //
  // `is_null()` is a `cratestack_sql::FieldRef` method on an optional column
  // (`filter/field_ref.rs:163`); `.eq(None)` is NOT — `Option<T>` does not
  // implement `IntoSqlValue`, which is a compile error rather than a silent
  // mismatch, and is how this was found.
  consumed_at DateTime?

  @@allow("read", auth().isSystem())
  @@allow("create", auth().isSystem())
  @@allow("update", auth().isSystem())
  @@allow("delete", auth().isSystem())
}

// --- invoices (S4b) -------------------------------------------------------

// `invoices` and `invoice_items` (migration 0036) — the merchant's bill to a
// payer, and the lines it is made of.
//
// THE FIRST MODEL IN THIS FILE WHOSE ENUM COLUMN WAS BORN WITH THE GENERATED
// CHECK NAME. Migration 0032 had to *rename* `providers.flow`'s hand-named
// CHECK to `providers_flow_enum_check` after the fact, because
// `diff/checks.rs` matches checks by name first. Migration 0036 creates
// `invoices_status_enum_check` under that name from the start, so
// `InvoiceStatus` below and the live constraint are one object to the diff
// engine rather than a drop-and-add pair.
//
// What that does NOT buy, and it is worth saying because the expectation is
// natural: the `column status type differs (live: Scalar("String"), schema:
// Enum("InvoiceStatus"))` line is permanent, exactly as `providers.flow`'s
// is. `introspect/postgres/enums.rs`' own doc comment calls it documented
// lossiness — a TEXT column has no catalog representation that recovers the
// enum's NAME — so no migration can close it. The measured net cost of both
// tables is in `docs/reference/vpay-db.md` §"Migration 0036".
//
// TWO METHODS RUN THROUGH THESE MODELS AND THE REST DO NOT, which is
// `model Customer`'s split for `model Customer`'s reason plus one that is new:
//
//   * `Invoices::mark_uncollectible` -> `Invoice.update`. It is the ONLY
//     transition with no event (Stripe's `invoice.marked_uncollectible` is
//     deliberately not in migration 0036's vocabulary), so it is the only one
//     that is a single statement rather than a transaction, and a
//     compare-and-swap `update_many` expresses it exactly.
//   * `Invoices::items_for_invoice` -> `InvoiceItem.read`. Every column of
//     `invoice_items` is declared, so the generated row carries the whole
//     line.
//
// Everything else is hand-written `sqlx`, and there are three distinct
// reasons rather than one:
//
//   1. `invoices.metadata` is `JSONB NOT NULL` and undeclared — `model
//      Customer`'s GAP note's two measured costs, unchanged. Any read of
//      `invoices` has to carry `metadata`, and the generated row has no field
//      for it, so every read of this table stays raw.
//   2. Three transitions (`create`, `finalize`, `void`) write an `events` row
//      in the same transaction, and `Events`' insert is itself blocked on
//      `events.data` (see `model Event`).
//   3. Every write to `invoice_items` carries a guard on a DIFFERENT table —
//      `EXISTS (SELECT 1 FROM invoices WHERE id = $1 AND status = 'draft')`,
//      which is what freezes an issued document. `cratestack::Filter`
//      compares columns of the model's own table, and there is no relation
//      that side-loads a parent's status into a child's `WHERE`.
enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

model Invoice {
  id String @id @length(min: 1, max: 64)
  // `GENERATED ALWAYS AS IDENTITY` (migration 0036). `model Customer.seq`'s
  // trade applies unchanged: one permanent `column `seq` default value
  // differs` line, and dropping the `@default(...)` would make `seq` a
  // REQUIRED field of `CreateInvoiceInput` — an explicit value for a
  // `GENERATED ALWAYS` column, which Postgres refuses outright.
  seq Int @default(dbgenerated())
  merchant_id String @length(min: 1, max: 128)
  livemode Boolean
  customer_id String @length(min: 1, max: 64)
  currency_code String @length(min: 3, max: 3)
  // The state machine. See this section's header for why the live CHECK is
  // named `invoices_status_enum_check` and what that does and does not buy.
  status InvoiceStatus
  // NULL exactly while the invoice is a draft (migration 0036's
  // `number_is_assigned_at_finalize`, a multi-column CHECK this grammar
  // cannot express and `migrate baseline` cannot see).
  //
  // No `@db_enforce` on the `@length`, for `model Customer`'s measured
  // reason: the live CHECK is hand-named `number_length`, `@db_enforce` would
  // generate `invoices_number_length_check`, and promoting it would emit a
  // drop-and-add PAIR where declaring it without `@db_enforce` emits nothing.
  // The validator is not inert — `inputs.rs::validate_impl_tokens` generates
  // `input.validate()` and every write path calls it before any SQL runs.
  number String? @length(min: 1, max: 64)
  amount_due Int
  amount_paid Int
  amount_remaining Int
  due_date DateTime?
  description String? @length(min: 1, max: 1000)
  payment_intent_id String? @length(min: 1, max: 64)
  finalized_at DateTime?
  paid_at DateTime?
  voided_at DateTime?
  marked_uncollectible_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  // `update`, and NOTHING else, because `mark_uncollectible` is the one
  // action this crate calls through this model.
  //
  // ITS LOSS IS SILENT, exactly as `model Customer`'s `update` arm's is:
  // `update_many`'s policy is compiled into the statement's own `WHERE`
  // (`update_many_exec.rs`), so a missing arm matches zero rows and returns
  // `BatchSummary { ok: 0 }` with no error. The observable effect is a
  // `POST /v1/invoices/{id}/mark_uncollectible` that answers `404` for an
  // invoice that is sitting there `open` — a merchant told their write-off
  // did not apply to an invoice that exists. `every_action_this_module_calls_has_an_allow_arm`
  // in `vpay-db/src/invoices.rs` fails in milliseconds with no container.
  @@allow("update", auth().isSystem())

  // GAP — `metadata JSONB NOT NULL` is not declared, and that is what keeps
  // every read and every write of this table except `mark_uncollectible` on
  // raw sqlx. `model Customer`'s GAP note carries the two measured costs
  // verbatim (`map_scalar` does not read `jsonb` back, so a declared column
  // would be a blocking drift line; and `Value::from_plain_json` demotes a
  // JSON number outside `i64` to `f64`, on a column that is
  // merchant-authored and echoed back inside every `invoice.*` webhook body).
  //
  // Migration 0036 leaves the column `NOT NULL` with **no DEFAULT** so the
  // omission is a loud `23502` rather than a silent `{}` over a merchant's
  // data. `a_generated_invoice_insert_cannot_carry_metadata` in
  // `vpay-db/src/invoices.rs` pins the rendered statement.
}

model InvoiceItem {
  id String @id @length(min: 1, max: 64)
  // See `model Invoice.seq`.
  seq Int @default(dbgenerated())
  invoice_id String @length(min: 1, max: 64)
  merchant_id String @length(min: 1, max: 128)
  livemode Boolean
  description String @length(min: 1, max: 1000)
  quantity Int
  unit_amount Int
  amount Int
  currency_code String @length(min: 3, max: 3)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  // `read`, and NOTHING else. `items_for_invoice` is a `find_many`, and every
  // write to this table carries the parent-status guard described in this
  // section's header.
  //
  // ITS LOSS IS *NOT* SILENT, which is the opposite of `model Invoice`'s
  // `update` arm and is worth stating because the asymmetry is what decides
  // how each is tested. `find_many` without a matching arm is a
  // `CratestackError::Forbidden` (`find_many_exec.rs` authorises before the
  // statement), so losing it turns every invoice read into a `500` — loud,
  // immediate, and caught by any container test that renders an invoice with
  // a line on it.
  @@allow("read", auth().isSystem())

  // NO GAP NOTE, and that is the point: every column of `invoice_items` is
  // declared above. The table was shaped so it could be — no `jsonb`, no
  // `bytea`, no native enum, no `int4` — which is migration 0035's discipline
  // applied to a table that also had to be readable through this layer.
}
