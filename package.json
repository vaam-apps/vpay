{
  "name": "@vymalo/vpay",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @vpay/e2e e2e",
    "storybook": "pnpm --filter @vpay/checkout storybook",
    "test-storybook": "pnpm --filter @vpay/checkout test-storybook",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.0"
  }
}
