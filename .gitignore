/target
**/node_modules
.next/
storybook-static/
dist/
*.log
# `next build` turns on `incremental`, which drops a tsbuildinfo next to the app.
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
# `**/`, not a bare `cypress/…`: a pattern containing a slash is anchored to
# the directory holding the .gitignore, so `cypress/screenshots/` matched only
# a top-level one and left `frontends/tests/e2e/cypress/screenshots/` — the
# only place Cypress actually writes — untracked and offerable. Corrected in
# Step 9 lane 6, on seeing a failed run leave nine PNGs in `git status`.
**/cypress/screenshots/
**/cypress/videos/

# Throwaway secrets, and the generated config that names their public halves,
# for the compose e2e and demo stacks:
#   just gen-e2e-signing-key  -> .e2e/oauth-signing-key.pem      (the OP's key)
#   just gen-demo-keys        -> .e2e/demo-merchant/…            (the merchant's)
#                                .e2e/application-demo.yml       (its public JWK)
# The whole directory is ignored deliberately, including the YAML: it is
# generated per checkout from a key that exists nowhere else, so a committed
# copy would register a merchant nobody can authenticate as.
.e2e/

# `zen generate`'s output for `examples/shop` — the TypeScript ZenStack 3's
# ORM reads (2026-09-06). Generated by the package's `postinstall`, exactly as
# the Prisma client used to be, and regenerated by every `pnpm install`; a
# committed copy would be a second source of truth beside
# `zenstack/schema.zmodel`, which is the one the CLI actually reads.
#
# `~schema.prisma` is the temporary Prisma schema `zen migrate` writes beside
# the zmodel and normally removes; it is listed so an interrupted run cannot
# leave one offerable.
examples/shop/zenstack/schema.ts
examples/shop/zenstack/models.ts
examples/shop/zenstack/input.ts
examples/shop/zenstack/~schema*.prisma
