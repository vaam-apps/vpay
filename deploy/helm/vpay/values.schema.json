{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vpay chart values",
  "description": "Shape only. Helm applies this before rendering a single template, so it catches a typo'd key or a string where a number belongs. It deliberately does NOT encode the semantic rules — a grace period shorter than the drain, a PDB that blocks every eviction, a token rate limit looser than the API's: those live in templates/_validate.tpl as named `fail` guards, so the error can explain itself and so ci/guards/*.yaml can prove each one fires. A guard values file must stay schema-valid or the schema error, not the guard, is what an operator sees.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "dashboard",
    "checkout",
    "server",
    "worker",
    "config",
    "database",
    "signingKey",
    "rails",
    "observability",
    "metrics",
    "service",
    "ingress",
    "route",
    "networkPolicy",
    "podDisruptionBudget",
    "serviceAccount"
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "namespace", "pullPolicy", "server"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string" } }
          }
        },
        "server": { "$ref": "#/definitions/imageRef" },
        "checkout": { "$ref": "#/definitions/imageRef" }
      }
    },

    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "description": "Not templated by this chart. `enabled: true` is a named template failure, not a workload. `publicOrigin` is consumed by nothing here for the same reason — it names VPAY_DASHBOARD_PUBLIC_ORIGIN on the separately-deployed dashboard, and its SHAPE is checked by the \"dashboard-public-origin\" guard because a trailing slash or a bare hostname there refuses every server action.",
      "properties": {
        "enabled": { "type": "boolean" },
        "publicOrigin": { "type": "string" }
      }
    },

    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "description": "vpay's own hosted/embedded payment page (Step 9, D3). Off by default. Shape only: the rules that cannot be expressed here — an enabled page with no publicApiUrl, and an Ingress that sets both host and path or neither — are the \"checkout-templated-when-enabled\" guard in templates/_validate.tpl, so the error can explain itself.",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } },

        "apiUrl": {
          "type": "string",
          "description": "This pod's view of vpay's API, for the server-side origins lookup. Empty means this release's own server Service."
        },
        "publicApiUrl": {
          "type": "string",
          "description": "A payer's browser's view of vpay's API. Required when enabled — enforced by the guard rather than here, so the message can say why a default would be worse."
        },

        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },

        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "host": { "type": "string" },
            "path": { "type": "string" },
            "pathType": {
              "type": "string",
              "enum": ["Exact", "Prefix", "ImplementationSpecific"]
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "clusterIssuer": { "type": "string" },
                "secretName": { "type": "string" }
              }
            },
            "limitRps": { "type": "integer" },
            "limitBurstMultiplier": { "type": "integer", "minimum": 1 }
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "description": "The payment page's Gateway API route. hostnames-or-path, exactly one, is the \"checkout-templated-when-enabled\" guard, not this schema.",
          "properties": {
            "enabled": { "type": "boolean" },
            "parentRefs": { "$ref": "#/definitions/parentRefs" },
            "hostnames": { "type": "array", "items": { "type": "string" } },
            "path": { "type": "string" },
            "pathType": {
              "type": "string",
              "enum": ["Exact", "PathPrefix", "RegularExpression"]
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "filters": { "$ref": "#/definitions/routeFilters" }
          }
        }
      }
    },

    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "port", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } }
      }
    },

    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "concurrency", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } }
      }
    },

    "shutdownGraceSeconds": { "type": "integer", "minimum": 1 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },

    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "path"],
      "properties": {
        "profile": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "createOverlayConfigMap": { "type": "boolean" },
        "overlay": { "type": "string" }
      }
    },

    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "existingSecretKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      }
    },

    "signingKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "key", "mountPath", "defaultMode"],
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 },
        "defaultMode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511,
          "description": "Decimal representation of the file mode. values.yaml writes it as 0440, which YAML parses as octal, i.e. 288."
        }
      }
    },

    "rails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string" } }
    },

    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "livenessPath", "metricsPath", "readinessPath"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "livenessPath": { "type": "string", "pattern": "^/" },
        "metricsPath": { "type": "string", "pattern": "^/" },
        "readinessPath": { "type": "string", "pattern": "^/" }
      }
    },

    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceMonitor", "prometheusRule"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "providerErrorRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "providerErrorWindow": {
              "type": "string",
              "pattern": "^[0-9]+[smhd]$"
            },
            "jobQueueBehindSeconds": { "type": "integer", "minimum": 1 },
            "alertEventWindow": {
              "type": "string",
              "pattern": "^[0-9]+[smhd]$"
            }
          }
        }
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "host", "tls", "api", "token"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterIssuer": { "type": "string" },
            "secretName": { "type": "string" }
          }
        },
        "api": { "$ref": "#/definitions/ingressRule" },
        "token": { "$ref": "#/definitions/ingressRule" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "path",
            "pathType",
            "limitRps",
            "limitBurstMultiplier"
          ],
          "description": "The rail callback's own Ingress object. POST /provider/{code}/callback is mounted at the root of vpay's router, not under /v1, so nothing else in this block routes it. Defaults to enabled; the provider-callback-routable guard is what refuses to turn it off in silence.",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" },
            "pathType": {
              "type": "string",
              "enum": ["Exact", "Prefix", "ImplementationSpecific"]
            },
            "limitRps": { "type": "integer" },
            "limitBurstMultiplier": { "type": "integer", "minimum": 1 },
            "sourceRange": {
              "type": "string",
              "description": "nginx.ingress.kubernetes.io/whitelist-source-range, rendered only when set. Empty means no allowlist."
            },
            "servedElsewhere": {
              "type": "string",
              "description": "One line naming what serves the callback when enabled is false. Free text: the guard refuses an empty one and cannot check a non-empty one."
            }
          }
        }
      }
    },

    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "parentRefs", "api", "token"],
      "description": "Gateway API routing, the alternative to `ingress` above for a cluster that runs a Gateway rather than ingress-nginx. Shape only, as everywhere here: an enabled route with no parentRefs, no resolvable hostname, or nothing rate-limiting the token endpoint are the \"route-attachment\" and \"route-rate-limit\" guards in templates/_validate.tpl, so the error can explain the consequence.",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "$ref": "#/definitions/parentRefs" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Empty falls back to [ingress.host]. Empty after that fallback is the route-attachment guard."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "rateLimitedBy": {
          "type": "string",
          "description": "One line naming what enforces /v1/oauth/token's rate limit when it is not an ExtensionRef filter on the token rule. Rendered onto the HTTPRoute as the vpay/rate-limited-by annotation. Free text on purpose: the route-rate-limit guard refuses silence, and a boolean would only be a box to tick."
        },
        "api": { "$ref": "#/definitions/httpRouteRule" },
        "token": { "$ref": "#/definitions/httpRouteRule" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path", "pathType"],
          "description": "The rail callback, as a third rule on the same HTTPRoute. See ingress.provider for why it exists and why it defaults on.",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" },
            "pathType": {
              "type": "string",
              "enum": ["Exact", "PathPrefix", "RegularExpression"]
            },
            "filters": { "$ref": "#/definitions/routeFilters" },
            "servedElsewhere": { "type": "string" }
          }
        }
      }
    },

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressControllerNamespace": { "type": "string" },
        "monitoringNamespace": { "type": "string" },
        "dnsNamespace": { "type": "string" },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": { "type": "array", "items": { "type": "string" } },
            "namespace": { "type": "string" },
            "podSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "railsEgress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "except": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "type": "integer",
          "minimum": 0,
          "description": "An integer, never a percentage string: the pdb-minavailable guard compares it with server.replicaCount, and a percentage would make that comparison a lie."
        }
      }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "logFilter": { "type": "string", "minLength": 1 },
    "logFormat": { "type": "string", "enum": ["json", "text"] }
  },

  "definitions": {
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "description": "Full digest, or empty. The exact shape is checked by the image-digest-format guard rather than here, so that the error names the guard and explains the consequence."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number"] }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number"] }
        }
      }
    },
    "ingressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pathType", "limitRps", "limitBurstMultiplier"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "pathType": {
          "type": "string",
          "enum": ["Exact", "Prefix", "ImplementationSpecific"]
        },
        "limitRps": { "type": "integer" },
        "limitBurstMultiplier": { "type": "integer", "minimum": 1 }
      }
    },
    "httpRouteRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pathType"],
      "description": "One HTTPRoute rule. `PathPrefix`, not the Ingress spelling `Prefix`: gateway.networking.k8s.io/v1 and networking.k8s.io/v1 disagree on the word, and a values file that carried the Ingress one over would be rejected by the API server rather than by Helm.",
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "pathType": {
          "type": "string",
          "enum": ["Exact", "PathPrefix", "RegularExpression"]
        },
        "filters": { "$ref": "#/definitions/routeFilters" }
      }
    },
    "parentRefs": {
      "type": "array",
      "items": { "type": "object" },
      "description": "A list of gateway.networking.k8s.io/v1 ParentReference, passed through verbatim so every field of it — group, kind, namespace, sectionName, port — is available without this chart modelling any of them. `name` is the one required field, and its absence is the \"route-attachment\" guard rather than a schema error, so the message can say what an unparented HTTPRoute actually does."
    },
    "routeFilters": {
      "type": "array",
      "items": { "type": "object" },
      "description": "A list of gateway.networking.k8s.io/v1 HTTPRouteFilter, passed through verbatim. This is the extension point for everything Gateway API leaves to the implementation — an ExtensionRef to a controller's own rate-limit object above all. Modelling its shape here would date the chart against a spec that is still adding filters."
    }
  }
}
