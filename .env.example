# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://vpay:vpay@localhost:5432/vpay
RUST_LOG=info
VPAY_PROFILE=sandbox

# vpay-server / vpay-worker-bin CLI (backends/crates/vpay-config/src/cli.rs).
# Every flag auto-resolves from these — an explicit CLI flag always wins.
VPAY_BIND=0.0.0.0:8080
# Required: both binaries refuse to start without a validated config file.
VPAY_CONFIG=config/application.yml
VPAY_PUBLIC_BASE_URL=
# Required by vpay-server: path to the RS256 private key (PKCS#8 PEM) the
# merchant OP signs /v1 access tokens with. `cargo xtask gen-signing-key --out <dir>`
# generates one; in the compose e2e stack `just gen-e2e-signing-key` does.
VPAY_OAUTH_SIGNING_KEY_FILE=
VPAY_LOG_FORMAT=json
VPAY_SHUTDOWN_GRACE_SECONDS=25

# Rail credentials — sandbox only. Production values live in your secret store.
# Names must match the `${VAR}` placeholders in config/application.yml: an
# unresolved placeholder is a fatal startup error, never an empty string.
MTN_SUBSCRIPTION_KEY=
# The UUID half of MTN's Basic credential, referenced by
# `providers[].settings.api_user` since 2026-09-03. Required: an unresolved
# placeholder is exit 78, never an empty string.
MTN_API_USER=
MTN_API_KEY=
ORANGE_MERCHANT_KEY=
# Orange's OAuth client credentials, referenced by
# `providers[].credentials.{client_id,client_secret}` since 2026-09-03. All
# five names above are now genuinely required by config/application.yml.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Dashboard
OIDC_ISSUER=
