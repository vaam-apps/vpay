# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://vpay:vpay@localhost:5432/vpay
RUST_LOG=info
VPAY_PROFILE=sandbox

# The `vpay-server` CLI, in every mode (backends/crates/vpay-config/src/cli.rs).
# One binary since 2026-09-07 (issue #77): no subcommand serves the API,
# `worker` runs the job loop, `staff add` creates a dashboard account. It read
# "vpay-server / vpay-worker-bin" while there were two.
# Every flag auto-resolves from these — an explicit CLI flag always wins.
VPAY_BIND=0.0.0.0:8080
# Required: neither long-running mode starts without a validated config file.
VPAY_CONFIG=config/application.yml
# The /livez + /metrics listener, in BOTH long-running modes. Never the same port as
# VPAY_BIND: /metrics must not be reachable from whatever fronts 8080.
VPAY_OBSERVABILITY_BIND=0.0.0.0:9090
# Required when serving the API (and read by no other mode): path to the RS256
# private key (PKCS#8 PEM) the
# merchant OP signs /v1 access tokens with. `cargo xtask gen-signing-key --out <dir>`
# generates one; in the compose e2e stack `just gen-e2e-signing-key` does.
VPAY_OAUTH_SIGNING_KEY_FILE=
VPAY_LOG_FORMAT=json
VPAY_SHUTDOWN_GRACE_SECONDS=25

# Rail credentials — sandbox only. Production values live in your secret store.
# Names must match the `${VAR}` placeholders in config/application.yml: an
# unresolved placeholder is a fatal startup error, never an empty string.
MTN_SUBSCRIPTION_KEY=
# The UUID half of MTN's Basic credential, referenced by
# `providers[].settings.api_user` since 2026-09-03. Required: an unresolved
# placeholder is exit 78, never an empty string.
MTN_API_USER=
MTN_API_KEY=
# MTN **Disbursements** — the refund product, added 2026-09-15 (RFC-0003 § 5).
# A different subscription key, a different API user and a separately scoped
# token from the three above (docs/flows/adapter-mtn-momo.md).
#
# Leave all three EMPTY unless you actually hold a Disbursements subscription.
# They must be *present* (an unresolved `${VAR}` is exit 78) and may be empty:
# an empty value is a value, and `mtn_momo::refund` treats a blank credential
# as a missing one and answers `ProviderError::Config` naming it. That is a
# refund that fails loudly, which is correct — **no deployment of this system
# holds these credentials and MTN's Disbursements product has never been
# called from this repository.**
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_DISBURSEMENT_API_USER=
MTN_DISBURSEMENT_API_KEY=
ORANGE_MERCHANT_KEY=
# Orange's OAuth client credentials, referenced by
# `providers[].credentials.{client_id,client_secret}` since 2026-09-03. All
# five names above are now genuinely required by config/application.yml.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Notch Pay (RFC-0012, ADR-0031). NOT required: the `notchpay` block in
# config/application.yml is commented out. Uncomment both lines when you
# uncomment it. Outside livemode both keys must contain `test.` or
# `test_` (real sandbox keys carry `test.`).
#
# PRODUCTION RISK: NOTCHPAY_PUBLIC_KEY is the key Notch Pay calls public, and
# it authenticates the status read. Anyone who holds it can read, initialize,
# process (a USSD prompt to any number) and cancel payments on the merchant's
# account. Keep it server-side, never in a front end. In livemode the rail
# also needs `settings.accept_public_key_exposure: true` in its YAML block or
# boot refuses it. See docs/flows/adapter-notchpay.md § "Production risks".
# NOTCHPAY_PUBLIC_KEY=
# NOTCHPAY_PRIVATE_KEY=
#
# The webhook endpoint's Hash Key, from Notch Pay's dashboard (RFC-0014). vpay
# checks every Notch Pay webhook's `x-notch-signature` against it, and a
# webhook that does not match moves nothing. A credential like the two keys
# above: never print, log or commit it. Without it, a sandbox boot WARNs that
# webhooks are unverified, and a livemode boot REFUSES the rail unless its
# block says `callbacks: { verify: off }`.
# NOTCHPAY_HASH_KEY=

# The HMAC-SHA256 key vpay signs this merchant's outbound webhooks with,
# referenced by `merchant_clients[].webhooks[].secrets` since 2026-09-03.
# Required for the same reason the five above are: an unresolved placeholder
# is exit 78 at boot, for both binaries.
#
# Unlike a rail credential, whoever holds this can *forge* a
# `payment_intent.succeeded` the merchant's handler will believe — so under
# `livemode: true` config/application.yml must keep it a `${VAR}` and never a
# literal (ConfigError::LiteralSecret, checked against the file's text before
# placeholders are resolved). The compose stacks set a stub value.
#
# Under livemode it must also be at least 32 bytes — HMAC-SHA256's own key
# size (ConfigError::WeakWebhookSecret, checked against the RESOLVED value, so
# a correctly written `${VAR}` holding `a` is still a refusal to boot).
# `openssl rand -hex 32` is a fine way to produce one.
MERCHANT_WEBHOOK_SECRET=

# Dashboard
OIDC_ISSUER=
