# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://vpay:vpay@localhost:5432/vpay
RUST_LOG=info
VPAY_PROFILE=sandbox

# vpay-server / vpay-worker-bin CLI (backends/crates/vpay-config/src/cli.rs).
# Every flag auto-resolves from these — an explicit CLI flag always wins.
VPAY_BIND=0.0.0.0:8080
VPAY_CONFIG=
VPAY_PUBLIC_BASE_URL=
VPAY_LOG_FORMAT=json
VPAY_SHUTDOWN_GRACE_SECONDS=25

# Rail credentials — sandbox only. Production values live in your secret store.
MTN_COLLECTION_KEY=
MTN_API_USER=
MTN_API_KEY=
ORANGE_MERCHANT_KEY=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Dashboard
OIDC_ISSUER=
