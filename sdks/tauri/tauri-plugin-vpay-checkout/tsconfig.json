{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The same floor `sdks/stripe-js` picked, and for the same reason: this
    // package runs in a merchant's bundler (a Tauri front end is a browser
    // document) and ES2020 is where native ESM, `AbortController` and
    // `window.open` are all present without a transform. `DOM` is not
    // optional here — `guest-js/host-web.ts` is a `window.open` popup host.
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "guest-js",
    // `guest-js/testing/**` and `*.test.ts` run under vitest on Node and
    // read the package's own source off disk with `node:fs/promises`. They
    // are excluded from the build (tsconfig.build.json) but still
    // typechecked here, which is why @types/node is present.
    "types": ["node"]
  },
  "include": ["guest-js"]
}
