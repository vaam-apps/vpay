{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `guest-js` is not in `files`, so a published .map would point at
    // nothing.
    "sourceMap": false,
    "declarationMap": false,
    // Nothing under `guest-js/` that ships touches Node. Dropping the
    // ambient Node globals from the build is what makes that checked rather
    // than intended: a `Buffer`, a `process` or a `node:fs` import reaching
    // shipping code fails here.
    "types": []
  },
  "include": ["guest-js"],
  "exclude": ["guest-js/**/*.test.ts", "guest-js/testing/**"]
}
