{
  "name": "@vaam-apps/vpay-stripe-js",
  "version": "0.1.0",
  "description": "A Stripe.js-shaped browser client for vpay's payer surface: payment intents, embedded and hosted Checkout, zero runtime dependencies.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/vpay.git",
    "directory": "sdks/stripe-js"
  },
  "homepage": "https://github.com/vaam-apps/vpay/tree/master/sdks/stripe-js#readme",
  "bugs": {
    "url": "https://github.com/vaam-apps/vpay/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@stripe/stripe-js": "9.15.0",
    "@types/node": "^22.10.0",
    "@vpay/config": "workspace:*",
    "eslint": "9.39.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
