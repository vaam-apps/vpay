<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="dev.vpay.checkout_flutter">

  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    D8, wired 2026-09-14: `androidx.browser`'s own recommended manifest
    entry so `CustomTabsIntent` can resolve a Custom-Tabs-capable browser
    on API 30+'s package-visibility restrictions
    (`VpayCheckoutExternalBrowserSession`). No custom URL scheme entry
    here or anywhere in this plugin, on purpose — design doc D8.
  -->
  <queries>
    <intent>
      <action android:name="android.support.customtabs.action.CustomTabsService" />
    </intent>
  </queries>

  <application>
    <!--
      D5 (docs/plans/2026-09-13-flutter-plugin.md): a plain Activity, full-bleed
      WebView, non-negotiably `android:exported="false"`. This Activity takes a
      URL extra that carries a payer credential (the checkout session's own
      secret, in the URL fragment) — an exported Activity accepting that extra
      is a classic intent-redirection hole: any other app on the device could
      start it directly, handing it an attacker-chosen URL to load with the
      plugin's own WebView settings, or intercepting the extra by other means.
      No other app has any business starting this Activity, so it is launched
      only by this same app's own Flutter engine, with `startActivityForResult`.

      Revised 2026-09-16 ("Modal checkout sheet" — the maintainer's own
      words: the old full-screen window "feels like the user is quitting the
      app"). `@style/Theme.Vpay.CheckoutSheet` (res/values/styles.xml) is
      translucent rather than opaque, so the merchant's own Activity stays
      visible behind this one — VpayCheckoutActivity.kt lays the WebView out
      as a Material `BottomSheetBehavior` sheet over it. Still the SAME
      Activity, still `exported="false"`: this is not a
      `BottomSheetDialogFragment` hosted by the merchant's own Activity —
      that would dissolve the Activity isolation the exported="false"/
      intent-redirection reasoning above rests on, for a cosmetically
      identical result.
    -->
    <activity
      android:name=".VpayCheckoutActivity"
      android:exported="false"
      android:theme="@style/Theme.Vpay.CheckoutSheet"
      android:configChanges="orientation|screenSize|keyboardHidden" />
  </application>

</manifest>
