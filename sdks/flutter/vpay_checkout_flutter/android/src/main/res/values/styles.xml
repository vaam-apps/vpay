<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    VpayCheckoutActivity's own theme (design D5, revised 2026-09-16 —
    "Modal checkout sheet", docs/plans/2026-09-13-flutter-plugin.md). The
    Activity is now presented as a Material bottom sheet over the merchant's
    app rather than a full-screen window ("feels like the user is quitting
    the app" — the maintainer's own words), and every item below exists to
    make that true without changing anything the manifest's own comment
    already promises about this Activity:

    - windowIsTranslucent: this is what actually keeps the merchant's own
      Activity, one below this one in the same task, drawn on screen —
      Android pauses it but does not stop or destroy it while a translucent
      Activity is on top, which is the whole trick. Without this the window
      is opaque and the merchant's app is gone the moment this Activity
      starts, which is the exact defect this change fixes.
    - windowIsFloating=false: this is a full-size (if see-through) window,
      not a Dialog-style floating one — VpayCheckoutActivity.kt draws its
      own scrim and its own BottomSheetBehavior-driven sheet in code; a
      floating window would fight both.
    - windowBackground=transparent: nothing here paints an opaque
      background of its own — the scrim and the sheet are code, not theme.
    - windowNoTitle / windowActionBar=false / windowContentOverlay=null: no
      chrome. windowFullscreen stays false on purpose, so the status bar is
      left showing above the sheet — this is not an edge-to-edge takeover,
      it is a sheet that leaves the merchant's own chrome visible around it.
    - windowAnimationStyle=@null: BottomSheetBehavior drives the
      slide-up/slide-down animation itself; a window-level enter/exit
      animation would fight it and was measured to double-animate.
  -->
  <style name="Theme.Vpay.CheckoutSheet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowIsFloating">false</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="windowActionBar">false</item>
    <item name="android:windowFullscreen">false</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowAnimationStyle">@null</item>
  </style>
</resources>
