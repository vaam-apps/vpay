{
  "name": "@vpay/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe-auth.d.ts",
      "default": "./dist/stripe-auth.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "stripe": "^22.6.1"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vpay/config": "workspace:*",
    "eslint": "9.39.5",
    "stripe": "^22.6.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
