{
  "name": "@vaam-apps/vpay-sdk",
  "version": "0.16.0",
  "description": "The Node.js merchant SDK for vpay's /v1 API: Ed25519-signed requests, payment intents, checkout sessions, refunds, events and webhook verification.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/vpay.git",
    "directory": "sdks/nodejs"
  },
  "homepage": "https://github.com/vaam-apps/vpay/tree/master/sdks/nodejs#readme",
  "bugs": {
    "url": "https://github.com/vaam-apps/vpay/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe-http-client.d.ts",
      "default": "./dist/stripe-http-client.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "wasm",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm-test": "bash scripts/build-wasm.sh --responder",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build:wasm && pnpm run build:wasm-test",
    "test": "vitest run",
    "test:live": "vitest run -c vitest.live.config.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "stripe": "^22.6.1"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vpay/config": "workspace:*",
    "eslint": "9.39.5",
    "stripe": "^22.6.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
